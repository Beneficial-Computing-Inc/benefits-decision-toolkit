meta {
  name: Pass - Blind Higher SGA Threshold
  type: http
  seq: 6
}

post {
  url: {{host}}/benefits/federal/ssdi-eligibility
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "primaryPersonId": "p1",
      "people": [
        {
          "id": "p1",
          "dateOfBirth": "1980-01-15",
          "isBlind": true,
          "hasWorkedAndPaidSSTaxes": true,
          "yearsWorkedInLast10Years": 6,
          "incomeSources": [
            {
              "type": "earned",
              "monthlyAmount": 2500
            }
          ]
        }
      ]
    }
  }
}

assert {
  res.status: eq 200
  res.body.checks.reportsDisablingCondition.checkResult: eq true
  res.body.checks.hasSufficientWorkCredits.checkResult: eq true
  res.body.checks.notAtFullRetirementAge.checkResult: eq true
  res.body.checks.notPerformingSga.checkResult: eq true
  res.body.isEligible: eq true
}

docs {
  POMS DI 10501.015 - Blind SGA Threshold
  Blind individuals have a higher SGA threshold of $2,700/month (2025).
  Person earns $2,500/month which is below the blind threshold.
  Additionally, blind status counts as a disabling condition for SSDI.
}
