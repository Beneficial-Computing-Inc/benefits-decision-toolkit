  auth: inherit
}

body:json {
  {
    "situation": {
      "evaluationDate": "2025-01-01",
      "primaryPersonId": "p1",
      "people": [
        {
          "id": "p1",
          "dateOfBirth": "1990-06-15",
          "citizenshipStatus": "UNDOCUMENTED",
          "isBlind": false, "isDisabled": false,
          "residenceState": "GU",
          "countableResources": 3000,
          "incomeSources": [
            {
              "id": "inc1",
              "type": "earned",
              "category": "wages",
              "monthlyAmount": 3000,
              "description": "Full-time work",
              "isInfrequentOrIrregular": false
            }
          ]
        }
      ],
      "enrollments": [],
      "relationships": [],
      "simpleChecks": {}
    }
  }
}

assert {
  res.status: eq 200
  res.body.checks.categoricalEligible: eq false
  res.body.checks.citizenshipEligible: eq false
  res.body.checks.residenceEligible: eq false
  res.body.checks.resourceEligible: eq false
  res.body.checks.incomeEligible: eq false
