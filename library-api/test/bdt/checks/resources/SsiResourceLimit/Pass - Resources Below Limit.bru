meta {
  name: Pass - Resources Below Limit
  type: http
  seq: 1
}

post {
  url: {{host}}/checks/resources/ssi-resource-limit
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "people": [
        {
          "id": "p1",
          "resources": [
            {
              "id": "r1",
              "type": "bank_account",
              "value": 1500,
              "description": "Checking account"
            }
          ]
        }
      ],
      "relationships": []
    },
    "parameters": {
      "personId": "p1"
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq true
}

settings {
  encodeUrl: true
  timeout: 0
}
