meta {
  name: Fail - Resources Above Limit
  type: http
  seq: 2
}

post {
  url: {{host}}/checks/resources/ssi-resource-limit
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "people": [
        {
          "id": "p1",
          "resources": [
            {
              "id": "r1",
              "type": "bank_account",
              "value": 2500,
              "description": "Savings account"
            }
          ]
        }
      ],
      "relationships": []
    },
    "parameters": {
      "personId": "p1"
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq false
}

settings {
  encodeUrl: true
  timeout: 0
}
