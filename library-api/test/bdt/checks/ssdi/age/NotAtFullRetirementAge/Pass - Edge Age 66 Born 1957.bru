meta {
  name: Pass - Edge Age 66 Born 1959
  type: http
  seq: 5
}

post {
  url: {{host}}/checks/ssdi/age/not-at-full-retirement-age
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "primaryPersonId": "p1",
      "people": [
        {
          "id": "p1",
          "dateOfBirth": "1959-10-26"
        }
      ]
    },
    "parameters": {}
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq true
  res.body.fraCalculation.hasAttainedFra: eq false
}

docs {
  POMS DI 10105.080 - Born 1959-10-26, FRA = 66 + 10/12 = 66.833.
  At eval ~2026-02, person is 66yr 4mo = decimal age 66.333.
  66.333 < 66.833 -> NOT at FRA = eligible for SSDI consideration.
  Tests the edge case where birth year has fractional FRA months.
}
