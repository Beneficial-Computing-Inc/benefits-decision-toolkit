meta {
  name: Pass - Age 35 Worked 6 Years
  type: http
  seq: 1
}

post {
  url: {{host}}/checks/ssdi/work-credits/has-sufficient-work-credits
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "primaryPersonId": "p1",
      "people": [
        {
          "id": "p1",
          "dateOfBirth": "1990-01-15",
          "hasWorkedAndPaidSSTaxes": true,
          "yearsWorkedInLast10Years": 6
        }
      ]
    },
    "parameters": {}
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq true
  res.body.workCreditsCalculation.ageRuleApplied: eq "age_31_plus"
  res.body.workCreditsCalculation.requiredYearsOfWork: eq 5
  res.body.workCreditsCalculation.meetsWorkRequirement: eq true
}

docs {
  RS 00301.120 - Age 35 person with 6 years of work in last 10 years.
  Rule: Age 31+ needs 5 years (20/40 test). 6 >= 5, so eligible.
}
