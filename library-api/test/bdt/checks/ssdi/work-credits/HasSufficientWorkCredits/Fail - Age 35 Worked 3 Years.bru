meta {
  name: Fail - Age 35 Worked 3 Years
  type: http
  seq: 2
}

post {
  url: {{host}}/checks/ssdi/work-credits/has-sufficient-work-credits
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "primaryPersonId": "p1",
      "people": [
        {
          "id": "p1",
          "dateOfBirth": "1990-01-15",
          "hasWorkedAndPaidSSTaxes": true,
          "yearsWorkedInLast10Years": 3
        }
      ]
    },
    "parameters": {}
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq false
}

docs {
  RS 00301.120 - Age 35 person with only 3 years of work in last 10 years.
  Recent Work Test: 3 < 5 = FAIL (needs 5 years in last 10 for age 31+)
  Source: ssa.gov/benefits/retirement/planner/credits
}
