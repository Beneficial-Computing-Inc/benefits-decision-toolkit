meta {
  name: Backward Compat - No ApproxYears
  type: http
  seq: 14
}

post {
  url: {{host}}/checks/ssdi/work-credits/has-sufficient-work-credits
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "primaryPersonId": "p1",
      "evaluationDate": "2026-03-18",
      "people": [
        {
          "id": "p1",
          "dateOfBirth": "1991-01-01",
          "isDisabled": true,
          "hasWorkedAndPaidSSTaxes": true,
          "yearsWorkedInLast10Years": 6
        }
      ]
    },
    "parameters": {
      "personId": "p1"
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq true
}

docs {
  Backward compatibility: no approximateYearsWorked field provided.
  Age 35 with 6 years recent work.
  Recent Work Test: 6 >= 5 = PASS
  Duration of Work Test: (35-22)/4 = 3.25 years needed, falls back to yearsWorkedInLast10Years (6) >= 3.25 = PASS
  Ensures old callers without the new field still work correctly.
}
