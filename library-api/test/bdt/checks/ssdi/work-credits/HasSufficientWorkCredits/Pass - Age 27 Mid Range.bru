meta {
  name: Pass - Age 27 Mid Range
  type: http
  seq: 5
}

post {
  url: {{host}}/checks/ssdi/work-credits/has-sufficient-work-credits
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "primaryPersonId": "p1",
      "people": [
        {
          "id": "p1",
          "dateOfBirth": "1998-06-15",
          "hasWorkedAndPaidSSTaxes": true,
          "yearsWorkedInLast10Years": 4
        }
      ]
    },
    "parameters": {}
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq true
  res.body.workCreditsCalculation.ageRuleApplied: eq "age_24_to_30"
  res.body.workCreditsCalculation.meetsWorkRequirement: eq true
}

docs {
  RS 00301.140 - Age 27 needs work in half the quarters since age 21.
  Rule: (27-21)/2 = 3 years required. Person has 4 years, so eligible.
}
