meta {
  name: Pass - Age 27 Mid Range
  type: http
  seq: 5
}

post {
  url: {{host}}/checks/ssdi/work-credits/has-sufficient-work-credits
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "primaryPersonId": "p1",
      "people": [
        {
          "id": "p1",
          "dateOfBirth": "1998-06-15",
          "hasWorkedAndPaidSSTaxes": true,
          "yearsWorkedInLast10Years": 4
        }
      ]
    },
    "parameters": {}
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq true
}

docs {
  Age 27 with 4 years of work. Uses dual-test structure:
  Recent Work Test + Duration of Work Test.
  See: https://www.ssa.gov/benefits/retirement/planner/credits
}
