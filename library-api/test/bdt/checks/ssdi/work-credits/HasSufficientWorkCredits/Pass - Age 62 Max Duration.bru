meta {
  name: Pass - Age 62 Max Duration
  type: http
  seq: 13
}

post {
  url: {{host}}/checks/ssdi/work-credits/has-sufficient-work-credits
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "primaryPersonId": "p1",
      "evaluationDate": "2026-03-18",
      "people": [
        {
          "id": "p1",
          "dateOfBirth": "1964-01-01",
          "isDisabled": true,
          "hasWorkedAndPaidSSTaxes": true,
          "yearsWorkedInLast10Years": 6,
          "approximateYearsWorked": 10
        }
      ]
    },
    "parameters": {
      "personId": "p1"
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq true
}

docs {
  Age 62, near maximum Duration of Work Test requirement.
  Recent Work Test: 6 >= 5 = PASS
  Duration of Work Test: (62-22)/4 = 10 years needed, 10 >= 10 = PASS
  Source: ssa.gov/benefits/retirement/planner/credits, POMS RS 00301.120
}
