meta {
  name: Pass - Blind Only Needs Ever Worked
  type: http
  seq: 4
}

post {
  url: {{host}}/checks/ssdi/work-credits/has-sufficient-work-credits
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "primaryPersonId": "p1",
      "people": [
        {
          "id": "p1",
          "dateOfBirth": "1980-01-15",
          "isBlind": true,
          "hasWorkedAndPaidSSTaxes": true,
          "yearsWorkedInLast10Years": 2
        }
      ]
    },
    "parameters": {}
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq true
}

docs {
  Blind individuals only need Duration of Work Test (fully insured status).
  They are exempt from the Recent Work Test. Age 44, only 2 years worked,
  but has worked and paid SS taxes, so eligible. Uses dual-test structure:
  Recent Work Test + Duration of Work Test.
  See: https://www.ssa.gov/benefits/retirement/planner/credits
}
