meta {
  name: Fail - Age 30 Worked 4 Years
  type: http
  seq: 9
}

post {
  url: {{host}}/checks/ssdi/work-credits/has-sufficient-work-credits
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "primaryPersonId": "p1",
      "evaluationDate": "2026-03-18",
      "people": [
        {
          "id": "p1",
          "dateOfBirth": "1996-01-01",
          "isDisabled": true,
          "hasWorkedAndPaidSSTaxes": true,
          "yearsWorkedInLast10Years": 4,
          "approximateYearsWorked": 4
        }
      ]
    },
    "parameters": {
      "personId": "p1"
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq false
}

docs {
  Age 30 with only 4 years of work.
  Recent Work Test: (30-21)/2 = 4.5 years needed, 4 < 4.5 = FAIL
  Source: ssa.gov/benefits/retirement/planner/credits
}
