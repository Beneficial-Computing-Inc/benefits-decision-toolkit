meta {
  name: Fail - Age 50 Insufficient Recent
  type: http
  seq: 12
}

post {
  url: {{host}}/checks/ssdi/work-credits/has-sufficient-work-credits
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "primaryPersonId": "p1",
      "evaluationDate": "2026-03-18",
      "people": [
        {
          "id": "p1",
          "dateOfBirth": "1976-01-01",
          "isDisabled": true,
          "hasWorkedAndPaidSSTaxes": true,
          "yearsWorkedInLast10Years": 3,
          "approximateYearsWorked": 12
        }
      ]
    },
    "parameters": {
      "personId": "p1"
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq false
}

docs {
  Age 50, passes Duration of Work Test but fails Recent Work Test.
  Recent Work Test: 3 < 5 = FAIL
  Duration of Work Test: (50-22)/4 = 7 years needed, 12 >= 7 = PASS
  Source: ssa.gov/benefits/retirement/planner/credits, POMS RS 00301.120
}
