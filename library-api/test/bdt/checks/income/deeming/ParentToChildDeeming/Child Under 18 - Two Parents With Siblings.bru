meta {
  name: Child Under 18 - Two Parents With Siblings
  type: http
  seq: 3
}

post {
  url: {{host}}/checks/income/deeming/parent-to-child-deeming
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "evaluationDate": "2025-01-15",
      "people": [
        {
          "id": "child1",
          "dateOfBirth": "2012-03-15",
          "isSSIEligible": true,
          "isBlindOrDisabled": true
        },
        {
          "id": "sibling1",
          "dateOfBirth": "2014-08-20",
          "isSSIEligible": false
        },
        {
          "id": "sibling2",
          "dateOfBirth": "2017-11-05",
          "isSSIEligible": false
        },
        {
          "id": "parent1",
          "dateOfBirth": "1982-01-01",
          "isSSIEligible": false,
          "incomeSources": [
            {
              "id": "inc1",
              "type": "earned",
              "monthlyAmount": 4000
            }
          ]
        },
        {
          "id": "parent2",
          "dateOfBirth": "1984-05-15",
          "isSSIEligible": false,
          "incomeSources": [
            {
              "id": "inc2",
              "type": "earned",
              "monthlyAmount": 2000
            },
            {
              "id": "inc3",
              "type": "unearned",
              "monthlyAmount": 100
            }
          ]
        }
      ],
      "relationships": [
        {
          "type": "parent",
          "personId": "parent1",
          "relatedPersonId": "child1"
        },
        {
          "type": "parent",
          "personId": "parent2",
          "relatedPersonId": "child1"
        },
        {
          "type": "parent",
          "personId": "parent1",
          "relatedPersonId": "sibling1"
        },
        {
          "type": "parent",
          "personId": "parent2",
          "relatedPersonId": "sibling1"
        },
        {
          "type": "parent",
          "personId": "parent1",
          "relatedPersonId": "sibling2"
        },
        {
          "type": "parent",
          "personId": "parent2",
          "relatedPersonId": "sibling2"
        }
      ]
    },
    "parameters": {
      "personId": "child1",
      "individualFBR": 967,
      "coupleFBR": 1450
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq true
  res.body.deemingCalculation.deemingApplies: eq true
  res.body.deemingCalculation.deemingType: eq "parent"
  res.body.deemingCalculation.numberOfParents: eq 2
  res.body.deemingCalculation.livingAllowanceAllocated: eq 1450
  res.body.deemingCalculation.numberOfIneligibleChildren: eq 2
}

docs {
  POMS SI 01320.500 - Parent-to-child deeming for child under 18 with two parents and two ineligible siblings.

  Child born 2012-03-15 is 12 years old as of 2025-01-15.
  Combined parent income: $4,000 + $2,000 earned = $6,000 earned + $100 unearned = $6,100 total

  Countable calculation:
  - $100 unearned - $20 = $80 countable unearned
  - $6,000 earned - $0 spillover - $65 = $5,935, then /2 = $2,967.50 countable earned
  - Total countable: $80 + $2,967.50 = $3,047.50

  Two parent living allowance: $1,450 (couple FBR)
  Ineligible children allocation: 2 x ($967/2) = 2 x $483.50 = $967

  Deemed income: $3,047.50 - $1,450 - $967 = $630.50
}
