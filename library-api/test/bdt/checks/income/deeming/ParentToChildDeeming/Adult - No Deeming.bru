meta {
  name: Adult - No Deeming
  type: http
  seq: 1
}

post {
  url: {{host}}/checks/income/deeming/parent-to-child-deeming
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "evaluationDate": "2025-01-15",
      "people": [
        {
          "id": "adult1",
          "dateOfBirth": "1990-01-01",
          "isSSIEligible": true
        },
        {
          "id": "parent1",
          "dateOfBirth": "1965-01-01",
          "isSSIEligible": false,
          "incomeSources": [
            {
              "id": "inc1",
              "type": "earned",
              "monthlyAmount": 3000
            }
          ]
        }
      ],
      "relationships": [
        {
          "type": "parent",
          "personId": "parent1",
          "relatedPersonId": "adult1"
        }
      ]
    },
    "parameters": {
      "personId": "adult1"
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq false
  res.body.deemingCalculation.deemingApplies: eq false
  res.body.deemingCalculation.deemingType: eq "none"
  res.body.deemingCalculation.deemedIncome: eq 0
}

docs {
  POMS SI 01320.500 - Parent-to-child deeming does not apply to adults (18+).
  Person born 1990-01-01 is 35 years old as of 2025-01-15.
}
