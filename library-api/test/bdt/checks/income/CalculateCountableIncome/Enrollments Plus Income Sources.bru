meta {
  name: Enrollments Plus Income Sources
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/checks/income/calculate-countable-income
  body: json
  auth: none
}

body:json {
  {
    "situation": {
      "evaluationDate": "2025-01-15",
      "people": [{
        "id": "person1",
        "dateOfBirth": "1960-06-01",
        "isSSIEligible": true,
        "incomeSources": [
          {"id": "inc1", "type": "earned", "monthlyAmount": 500}
        ]
      }],
      "enrollments": [{
        "personId": "person1",
        "benefit": "VA_DISABILITY_COMP",
        "status": "RECEIVING",
        "monthlyAmount": 200
      }]
    },
    "parameters": {
      "personId": "person1",
      "FBR": 967
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq true
  res.body.incomeCalculation.totalEarnedIncome: eq 500
  res.body.incomeCalculation.unearnedFromBenefits: eq 200
  res.body.incomeCalculation.totalUnearnedIncome: eq 200
  res.body.incomeCalculation.countableUnearnedIncome: eq 180
  res.body.incomeCalculation.meetsIncomeLimit: eq true
}

docs {
  Combined enrollment income + regular income sources.

  Person has:
  - VA Disability Comp: $200/month (enrollment, counts as unearned)
  - Wages: $500/month (incomeSource, earned)

  Calculation:
  - Unearned: $200 (from VA)
  - After $20 general exclusion: $180 countable unearned
  - Earned: $500
  - After $65 earned exclusion + 50%: ($500 - $65) / 2 = $217.50 countable earned
  - Total countable: $180 + $217.50 = $397.50
  - FBR: $967
  - Result: Passes income limit
}
