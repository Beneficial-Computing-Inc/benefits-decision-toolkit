meta {
  name: Pass - Spouse of Veteran
  type: http
  seq: 6
}

post {
  url: {{host}}/checks/citizenship/lapr-with-exception
  body: json
  auth: none
}

body:json {
  {
    "situation": {
      "primaryPersonId": "person1",
      "evaluationDate": "2025-01-15",
      "people": [
        {
          "id": "person1",
          "dateOfBirth": "1975-01-01",
          "citizenshipStatus": "LAPR",
          "isSpouseOfVeteranOrActiveDuty": true
        }
      ]
    },
    "parameters": {
      "personId": "person1"
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq true
}

docs {
  POMS SI 00502.140A.5 - LAPR spouse of veteran or active duty service member.
  Includes unremarried surviving spouse. Exception has no time limit.
}
