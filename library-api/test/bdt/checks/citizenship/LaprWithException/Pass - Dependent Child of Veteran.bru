meta {
  name: Pass - Dependent Child of Veteran
  type: http
  seq: 7
}

post {
  url: {{host}}/checks/citizenship/lapr-with-exception
  body: json
  auth: none
}

body:json {
  {
    "situation": {
      "primaryPersonId": "person1",
      "evaluationDate": "2025-01-15",
      "people": [
        {
          "id": "person1",
          "dateOfBirth": "2010-06-01",
          "citizenshipStatus": "LAPR",
          "isDependentChildOfVeteranOrActiveDuty": true
        }
      ]
    },
    "parameters": {
      "personId": "person1"
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq true
}

docs {
  POMS SI 00502.140A.6 - LAPR unmarried dependent child of veteran or active duty member.
  Must be under 18 (or under 22 if student). Exception has no time limit.
}
