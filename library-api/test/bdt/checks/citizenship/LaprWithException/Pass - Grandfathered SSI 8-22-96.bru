meta {
  name: Pass - Grandfathered SSI 8-22-96
  type: http
  seq: 9
}

post {
  url: {{host}}/checks/citizenship/lapr-with-exception
  body: json
  auth: none
}

body:json {
  {
    "situation": {
      "primaryPersonId": "person1",
      "evaluationDate": "2025-01-15",
      "people": [
        {
          "id": "person1",
          "dateOfBirth": "1950-01-01",
          "citizenshipStatus": "LAPR",
          "wasReceivingSSIOn8221996": true
        }
      ]
    },
    "parameters": {
      "personId": "person1"
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq true
}

docs {
  POMS SI 00502.100A.1 - LAPR who was receiving SSI benefits on 8/22/96.
  Grandfathered eligibility applies regardless of other exception conditions.
}
