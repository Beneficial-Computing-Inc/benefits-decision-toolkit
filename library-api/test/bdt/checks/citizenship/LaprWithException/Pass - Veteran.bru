meta {
  name: Pass - Veteran
  type: http
  seq: 4
}

post {
  url: {{host}}/checks/citizenship/lapr-with-exception
  body: json
  auth: none
}

body:json {
  {
    "situation": {
      "primaryPersonId": "person1",
      "evaluationDate": "2025-01-15",
      "people": [
        {
          "id": "person1",
          "dateOfBirth": "1970-01-01",
          "citizenshipStatus": "LAPR",
          "isVeteran": true
        }
      ]
    },
    "parameters": {
      "personId": "person1"
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq true
}

docs {
  POMS SI 00502.140 - LAPR who is a veteran (honorably discharged, 2+ years active duty).
  Veteran exception has no time limit and no 5-year bar.
}
