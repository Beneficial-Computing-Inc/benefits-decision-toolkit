meta {
  name: Pass - 40 QQ Pre-Welfare-Reform Entry
  type: http
  seq: 1
}

post {
  url: {{host}}/checks/citizenship/lapr-with-exception
  body: json
  auth: none
}

body:json {
  {
    "situation": {
      "primaryPersonId": "person1",
      "evaluationDate": "2025-01-15",
      "people": [
        {
          "id": "person1",
          "dateOfBirth": "1960-01-01",
          "citizenshipStatus": "LAPR",
          "qualifyingQuarters": 40,
          "usEntryDate": "1990-06-15"
        }
      ]
    },
    "parameters": {
      "personId": "person1"
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq true
}

docs {
  POMS SI 00502.135 - LAPR with 40 qualifying quarters who entered before 8/22/96.
  No 5-year bar applies since entry was before welfare reform date.
}
