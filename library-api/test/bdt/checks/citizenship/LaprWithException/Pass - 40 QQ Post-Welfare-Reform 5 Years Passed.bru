meta {
  name: Pass - 40 QQ Post-Welfare-Reform 5 Years Passed
  type: http
  seq: 2
}

post {
  url: {{host}}/checks/citizenship/lapr-with-exception
  body: json
  auth: none
}

body:json {
  {
    "situation": {
      "primaryPersonId": "person1",
      "evaluationDate": "2025-01-15",
      "people": [
        {
          "id": "person1",
          "dateOfBirth": "1970-01-01",
          "citizenshipStatus": "LAPR",
          "qualifyingQuarters": 45,
          "usEntryDate": "2010-01-01"
        }
      ]
    },
    "parameters": {
      "personId": "person1"
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq true
}

docs {
  POMS SI 00502.135B.1 - LAPR with 40 QQs who entered after 8/22/96 but 5-year bar has passed.
  Entry 2010-01-01 + 5 years = 2015-01-01, evaluation 2025-01-15, so 5-year bar passed.
}
