meta {
  name: Pass - Active Duty Military
  type: http
  seq: 5
}

post {
  url: {{host}}/checks/citizenship/lapr-with-exception
  body: json
  auth: none
}

body:json {
  {
    "situation": {
      "primaryPersonId": "person1",
      "evaluationDate": "2025-01-15",
      "people": [
        {
          "id": "person1",
          "dateOfBirth": "1990-01-01",
          "citizenshipStatus": "LAPR",
          "isActiveDutyMilitary": true
        }
      ]
    },
    "parameters": {
      "personId": "person1"
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq true
}

docs {
  POMS SI 00502.140A.2 - LAPR currently on active duty in US Armed Forces.
  Active duty military exception has no time limit.
}
