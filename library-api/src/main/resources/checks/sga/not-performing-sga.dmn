<?xml version="1.0" encoding="UTF-8"?>
<dmn:definitions xmlns:dmn="http://www.omg.org/spec/DMN/20180521/MODEL/" xmlns="https://kie.apache.org/dmn/_SGA-NOT-PERFORMING-2026-0115" xmlns:feel="http://www.omg.org/spec/DMN/20180521/FEEL/" xmlns:kie="http://www.drools.org/kie/dmn/1.2" xmlns:dmndi="http://www.omg.org/spec/DMN/20180521/DMNDI/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:BDT="https://kie.apache.org/dmn/_1B91A885-130A-4E0B-A762-E12AA6DD5C79" id="_SGA-NOT-PERFORMING-DEF" name="NotPerformingSga" typeLanguage="http://www.omg.org/spec/DMN/20180521/FEEL/" namespace="https://kie.apache.org/dmn/_SGA-NOT-PERFORMING-2026-0115">
  <dmn:description>POMS DI 10501.015 - Substantial Gainful Activity (SGA) Check for SSDI Eligibility

Determines if a person's current earnings are below the SGA threshold, making them potentially eligible for SSDI disability benefits.

Per DI 10105.065: "If an individual is working and the work is determined to be SGA, we will find that the individual is not disabled regardless of his/her medical condition, age, education, or work experience."

2025 SGA Thresholds:
- Non-blind: $1,620/month
- Blind (Title II only): $2,700/month

NOTE: This check applies to SSDI (Title II) only. Blind individuals under SSI (Title XVI) are NOT subject to SGA limitations per DI 10501.015.

Returns TRUE if person is NOT performing SGA (eligible), FALSE if performing SGA (ineligible).</dmn:description>
  <dmn:extensionElements/>
  <dmn:import id="_SGA-IMPORT-BDT" name="BDT" namespace="https://kie.apache.org/dmn/_1B91A885-130A-4E0B-A762-E12AA6DD5C79" locationURI="../../BDT.dmn" importType="http://www.omg.org/spec/DMN/20180521/MODEL/"/>
  <dmn:itemDefinition id="_SGA-TPARAMETERS" name="tParameters" isCollection="false">
    <dmn:description>Parameters for SGA check</dmn:description>
    <dmn:itemComponent id="_SGA-PARAM-PERSONID" name="personId" isCollection="false">
      <dmn:description>ID of person to evaluate (defaults to primaryPersonId if not provided)</dmn:description>
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:decisionService id="_SGA-SERVICE" name="NotPerformingSgaService">
    <dmn:description>POMS DI 10501.015 - Checks if person's earnings are below SGA threshold for SSDI eligibility</dmn:description>
    <dmn:extensionElements/>
    <dmn:variable id="_SGA-SERVICE-VAR" name="NotPerformingSgaService" typeRef="BDT.tCheckResponse"/>
    <dmn:outputDecision href="#_SGA-DECISION-CHECKRESULT"/>
    <dmn:inputData href="#_SGA-INPUT-SITUATION"/>
    <dmn:inputData href="#_SGA-INPUT-PARAMETERS"/>
  </dmn:decisionService>
  <dmn:inputData id="_SGA-INPUT-SITUATION" name="situation">
    <dmn:extensionElements/>
    <dmn:variable id="_SGA-INPUT-SITUATION-VAR" name="situation" typeRef="BDT.tSituation"/>
  </dmn:inputData>
  <dmn:inputData id="_SGA-INPUT-PARAMETERS" name="parameters">
    <dmn:extensionElements/>
    <dmn:variable id="_SGA-INPUT-PARAMETERS-VAR" name="parameters" typeRef="tParameters"/>
  </dmn:inputData>
  <dmn:decision id="_SGA-DECISION-CHECKRESULT" name="checkResult">
    <dmn:description>TRUE if person is NOT performing SGA (eligible for SSDI consideration), FALSE if performing SGA (ineligible)</dmn:description>
    <dmn:extensionElements/>
    <dmn:variable id="_SGA-DECISION-CHECKRESULT-VAR" name="checkResult" typeRef="boolean"/>
    <dmn:informationRequirement id="_SGA-IR-1">
      <dmn:requiredInput href="#_SGA-INPUT-SITUATION"/>
    </dmn:informationRequirement>
    <dmn:informationRequirement id="_SGA-IR-2">
      <dmn:requiredInput href="#_SGA-INPUT-PARAMETERS"/>
    </dmn:informationRequirement>
    <dmn:context id="_SGA-CTX">
      <dmn:contextEntry id="_SGA-CTX-PERSONID">
        <dmn:variable id="_SGA-CTX-PERSONID-VAR" name="personId" typeRef="string"/>
        <dmn:literalExpression id="_SGA-EXPR-PERSONID">
          <dmn:text>if parameters.personId != null then parameters.personId else situation.primaryPersonId</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry id="_SGA-CTX-PERSON">
        <dmn:variable id="_SGA-CTX-PERSON-VAR" name="person" typeRef="BDT.tPerson"/>
        <dmn:literalExpression id="_SGA-EXPR-PERSON">
          <dmn:text>situation.people[id = personId][1]</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry id="_SGA-CTX-EARNINGS">
        <dmn:variable id="_SGA-CTX-EARNINGS-VAR" name="monthlyEarnedIncome" typeRef="number"/>
        <dmn:literalExpression id="_SGA-EXPR-EARNINGS">
          <dmn:text>if person = null or person.incomeSources = null then 0 else sum(person.incomeSources[type = "earned"].monthlyAmount)</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry id="_SGA-CTX-ISBLIND">
        <dmn:variable id="_SGA-CTX-ISBLIND-VAR" name="isBlind" typeRef="boolean"/>
        <dmn:literalExpression id="_SGA-EXPR-ISBLIND">
          <dmn:text>if person = null then false else person.isBlind = true</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry id="_SGA-CTX-THRESHOLD">
        <dmn:variable id="_SGA-CTX-THRESHOLD-VAR" name="sgaThreshold" typeRef="number"/>
        <dmn:literalExpression id="_SGA-EXPR-THRESHOLD">
          <dmn:text>if isBlind then 2700 else 1620</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry id="_SGA-CTX-RESULT">
        <dmn:variable id="_SGA-CTX-RESULT-VAR" name="result" typeRef="boolean"/>
        <dmn:literalExpression id="_SGA-EXPR-RESULT">
          <dmn:text>monthlyEarnedIncome &lt;= sgaThreshold</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:literalExpression id="_SGA-EXPR-RETURN">
          <dmn:text>result</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
    </dmn:context>
  </dmn:decision>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="_SGA-DIAGRAM" name="SGA Check">
      <di:extension>
        <kie:ComponentsWidthsExtension/>
      </di:extension>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</dmn:definitions>
