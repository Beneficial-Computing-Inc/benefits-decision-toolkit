<?xml version="1.0" encoding="UTF-8"?>
<dmn:definitions xmlns:dmn="http://www.omg.org/spec/DMN/20180521/MODEL/" xmlns="https://kie.apache.org/dmn/_SSDI-WORK-CREDITS-2026-0115" xmlns:feel="http://www.omg.org/spec/DMN/20180521/FEEL/" xmlns:kie="http://www.drools.org/kie/dmn/1.2" xmlns:dmndi="http://www.omg.org/spec/DMN/20180521/DMNDI/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:BDT="https://kie.apache.org/dmn/_1B91A885-130A-4E0B-A762-E12AA6DD5C79" xmlns:Age="https://kie.apache.org/dmn/_81D401A8-CA81-4F9A-ABCC-532C25768708" id="_SSDI-WORK-CREDITS-DEF" name="HasSufficientWorkCredits" typeLanguage="http://www.omg.org/spec/DMN/20180521/FEEL/" namespace="https://kie.apache.org/dmn/_SSDI-WORK-CREDITS-2026-0115">
  <dmn:description>POMS DI 10105.060, RS 00301.120 - Work Credits (Insured Status) Check for SSDI Eligibility

Determines if a person has sufficient work history to qualify for SSDI benefits.
This is a simplified screener check based on age-specific work history questions.

Rules (from RS 00301.120 and RS 00301.140):
- Blind individuals: Only need "fully insured" status (ever worked and paid SS taxes)
- Under age 24: Need ~1.5 years of work in last 3 years (6 QCs in 12 quarters)
- Ages 24-30: Need work in about half the quarters since age 21
- Ages 31+: Need ~5 years of work in last 10 years (20/40 test)

Returns TRUE if person has sufficient work credits for SSDI consideration.</dmn:description>
  <dmn:extensionElements/>
  <dmn:import id="_WC-IMPORT-BDT" name="BDT" namespace="https://kie.apache.org/dmn/_1B91A885-130A-4E0B-A762-E12AA6DD5C79" locationURI="../../../BDT.dmn" importType="http://www.omg.org/spec/DMN/20180521/MODEL/"/>
  <dmn:import id="_WC-IMPORT-AGE" name="Age" namespace="https://kie.apache.org/dmn/_81D401A8-CA81-4F9A-ABCC-532C25768708" locationURI="../../age/Age.dmn" importType="http://www.omg.org/spec/DMN/20180521/MODEL/"/>
  <dmn:itemDefinition id="_WC-TPARAMETERS" name="tParameters" isCollection="false">
    <dmn:description>Parameters for work credits check</dmn:description>
    <dmn:itemComponent id="_WC-PARAM-PERSONID" name="personId" isCollection="false">
      <dmn:description>ID of person to evaluate (defaults to primaryPersonId if not provided)</dmn:description>
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:decisionService id="_WC-SERVICE" name="HasSufficientWorkCreditsService">
    <dmn:description>POMS DI 10105.060 - Checks if person has sufficient work credits for SSDI eligibility</dmn:description>
    <dmn:extensionElements/>
    <dmn:variable id="_WC-SERVICE-VAR" name="HasSufficientWorkCreditsService" typeRef="BDT.tCheckResponse"/>
    <dmn:outputDecision href="#_WC-DECISION-CHECKRESULT"/>
    <dmn:inputData href="#_WC-INPUT-SITUATION"/>
    <dmn:inputData href="#_WC-INPUT-PARAMETERS"/>
  </dmn:decisionService>
  <dmn:inputData id="_WC-INPUT-SITUATION" name="situation">
    <dmn:extensionElements/>
    <dmn:variable id="_WC-INPUT-SITUATION-VAR" name="situation" typeRef="BDT.tSituation"/>
  </dmn:inputData>
  <dmn:inputData id="_WC-INPUT-PARAMETERS" name="parameters">
    <dmn:extensionElements/>
    <dmn:variable id="_WC-INPUT-PARAMETERS-VAR" name="parameters" typeRef="tParameters"/>
  </dmn:inputData>
  <dmn:decision id="_WC-DECISION-CHECKRESULT" name="checkResult">
    <dmn:description>TRUE if person has sufficient work credits for SSDI, FALSE otherwise</dmn:description>
    <dmn:extensionElements/>
    <dmn:variable id="_WC-DECISION-CHECKRESULT-VAR" name="checkResult" typeRef="boolean"/>
    <dmn:informationRequirement id="_WC-IR-1">
      <dmn:requiredInput href="#_WC-INPUT-SITUATION"/>
    </dmn:informationRequirement>
    <dmn:informationRequirement id="_WC-IR-2">
      <dmn:requiredInput href="#_WC-INPUT-PARAMETERS"/>
    </dmn:informationRequirement>
    <dmn:knowledgeRequirement id="_WC-KR-AGE">
      <dmn:requiredKnowledge href="https://kie.apache.org/dmn/_81D401A8-CA81-4F9A-ABCC-532C25768708#_1919D943-09A4-4D5C-98A0-2B8377862E4C"/>
    </dmn:knowledgeRequirement>
    <dmn:context id="_WC-CTX">
      <dmn:contextEntry id="_WC-CTX-PERSONID">
        <dmn:variable id="_WC-CTX-PERSONID-VAR" name="personId" typeRef="string"/>
        <dmn:literalExpression id="_WC-EXPR-PERSONID">
          <dmn:text>if parameters.personId != null then parameters.personId else situation.primaryPersonId</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry id="_WC-CTX-PERSON">
        <dmn:variable id="_WC-CTX-PERSON-VAR" name="person" typeRef="BDT.tPerson"/>
        <dmn:literalExpression id="_WC-EXPR-PERSON">
          <dmn:text>situation.people[id = personId][1]</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry id="_WC-CTX-EVALDATE">
        <dmn:variable id="_WC-CTX-EVALDATE-VAR" name="evaluationDate" typeRef="date"/>
        <dmn:literalExpression id="_WC-EXPR-EVALDATE">
          <dmn:text>if situation.evaluationDate != null then situation.evaluationDate else today()</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry id="_WC-CTX-AGE">
        <dmn:variable id="_WC-CTX-AGE-VAR" name="age" typeRef="number"/>
        <dmn:literalExpression id="_WC-EXPR-AGE">
          <dmn:text>if person = null or person.dateOfBirth = null then -1 else Age.as of date(person.dateOfBirth, evaluationDate)</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry id="_WC-CTX-ISBLIND">
        <dmn:variable id="_WC-CTX-ISBLIND-VAR" name="isBlind" typeRef="boolean"/>
        <dmn:literalExpression id="_WC-EXPR-ISBLIND">
          <dmn:text>if person = null then false else person.isBlind = true</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry id="_WC-CTX-AGERULE">
        <dmn:variable id="_WC-CTX-AGERULE-VAR" name="ageRuleApplied" typeRef="string"/>
        <dmn:literalExpression id="_WC-EXPR-AGERULE">
          <dmn:text>if isBlind then "blind_fully_insured"
else if age &lt; 0 then "unknown"
else if age &lt; 24 then "under_24"
else if age &lt; 31 then "age_24_to_30"
else "age_31_plus"</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry id="_WC-CTX-REQYEARS">
        <dmn:variable id="_WC-CTX-REQYEARS-VAR" name="requiredYearsOfWork" typeRef="number"/>
        <dmn:literalExpression id="_WC-EXPR-REQYEARS">
          <dmn:text>if ageRuleApplied = "blind_fully_insured" then 0
else if ageRuleApplied = "unknown" then 0
else if ageRuleApplied = "under_24" then 1.5
else if ageRuleApplied = "age_24_to_30" then (age - 21) / 2
else 5</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry id="_WC-CTX-MEETSREQ">
        <dmn:variable id="_WC-CTX-MEETSREQ-VAR" name="meetsWorkRequirement" typeRef="boolean"/>
        <dmn:literalExpression id="_WC-EXPR-MEETSREQ">
          <dmn:text>if person = null then false
else if ageRuleApplied = "blind_fully_insured" then person.hasWorkedAndPaidSSTaxes = true
else if ageRuleApplied = "unknown" then false
else if person.yearsWorkedInLast10Years = null then false
else person.yearsWorkedInLast10Years >= requiredYearsOfWork</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry id="_WC-CTX-RESULT">
        <dmn:variable id="_WC-CTX-RESULT-VAR" name="result" typeRef="boolean"/>
        <dmn:literalExpression id="_WC-EXPR-RESULT">
          <dmn:text>meetsWorkRequirement</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:literalExpression id="_WC-EXPR-RETURN">
          <dmn:text>result</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
    </dmn:context>
  </dmn:decision>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="_WC-DIAGRAM" name="Work Credits Check">
      <di:extension>
        <kie:ComponentsWidthsExtension/>
      </di:extension>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</dmn:definitions>
