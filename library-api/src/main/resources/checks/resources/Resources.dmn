<?xml version="1.0" encoding="UTF-8"?>
<dmn:definitions xmlns:dmn="http://www.omg.org/spec/DMN/20180521/MODEL/" xmlns="https://kie.apache.org/dmn/_5A6B7C8D-9E0F-1A2B-3C4D-5E6F7A8B9C0D" xmlns:feel="http://www.omg.org/spec/DMN/20180521/FEEL/" xmlns:kie="http://www.drools.org/kie/dmn/1.2" xmlns:dmndi="http://www.omg.org/spec/DMN/20180521/DMNDI/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:included1="https://kie.apache.org/dmn/_1B91A885-130A-4E0B-A762-E12AA6DD5C79" id="_1D2E3F4A-5B6C-7D8E-9F0A-1B2C3D4E5F6A" name="Resources" typeLanguage="http://www.omg.org/spec/DMN/20180521/FEEL/" namespace="https://kie.apache.org/dmn/_5A6B7C8D-9E0F-1A2B-3C4D-5E6F7A8B9C0D">
  <dmn:extensionElements/>
  <dmn:import id="_2E3F4A5B-6C7D-8E9F-0A1B-2C3D4E5F6A7B" name="BDT" namespace="https://kie.apache.org/dmn/_1B91A885-130A-4E0B-A762-E12AA6DD5C79" locationURI="../../BDT.dmn" importType="http://www.omg.org/spec/DMN/20180521/MODEL/"/>
  <dmn:businessKnowledgeModel id="_3F4A5B6C-7D8E-9F0A-1B2C-3D4E5F6A7B8C" name="sum resources">
    <dmn:extensionElements/>
    <dmn:variable id="_4A5B6C7D-8E9F-0A1B-2C3D-4E5F6A7B8C9D" name="sum resources" typeRef="number"/>
    <dmn:encapsulatedLogic id="_5B6C7D8E-9F0A-1B2C-3D4E-5F6A7B8C9D0E" kind="FEEL">
      <dmn:formalParameter id="_6C7D8E9F-0A1B-2C3D-4E5F-6A7B8C9D0E1F" name="resources" typeRef="BDT.tResourceList"/>
      <dmn:literalExpression id="_7D8E9F0A-1B2C-3D4E-5F6A-7B8C9D0E1F2A">
        <dmn:text>if resources = null then
  0
else
  sum(for r in resources return r.value)</dmn:text>
      </dmn:literalExpression>
    </dmn:encapsulatedLogic>
  </dmn:businessKnowledgeModel>
  <dmn:businessKnowledgeModel id="_8E9F0A1B-2C3D-4E5F-6A7B-8C9D0E1F2A3B" name="filter resources by type">
    <dmn:extensionElements/>
    <dmn:variable id="_9F0A1B2C-3D4E-5F6A-7B8C-9D0E1F2A3B4C" name="filter resources by type" typeRef="BDT.tResourceList"/>
    <dmn:encapsulatedLogic id="_0A1B2C3D-4E5F-6A7B-8C9D-0E1F2A3B4C5D" kind="FEEL">
      <dmn:formalParameter id="_1B2C3D4E-5F6A-7B8C-9D0E-1F2A3B4C5D6E" name="resources" typeRef="BDT.tResourceList"/>
      <dmn:formalParameter id="_2C3D4E5F-6A7B-8C9D-0E1F-2A3B4C5D6E7F" name="type" typeRef="string"/>
      <dmn:literalExpression id="_3D4E5F6A-7B8C-9D0E-1F2A-3B4C5D6E7F8A">
        <dmn:text>if resources = null then
  []
else
  resources[item.type = type]</dmn:text>
      </dmn:literalExpression>
    </dmn:encapsulatedLogic>
  </dmn:businessKnowledgeModel>
  <dmn:textAnnotation id="_4E5F6A7B-8C9D-0E1F-2A3B-4C5D6E7F8A9B" textFormat="text/plain">
    <dmn:text>Base module for resource-related Business Knowledge Models (BKMs) and types.
Provides shared utilities for resource calculations across SSI resource exclusion checks.</dmn:text>
  </dmn:textAnnotation>
