<?xml version="1.0" encoding="UTF-8"?>
<dmn:definitions xmlns:dmn="http://www.omg.org/spec/DMN/20180521/MODEL/" xmlns="https://kie.apache.org/dmn/_F1A2B3C4-D5E6-7F8A-9B0C-1D2E3F4A5B6C" xmlns:feel="http://www.omg.org/spec/DMN/20180521/FEEL/" xmlns:kie="http://www.drools.org/kie/dmn/1.2" xmlns:dmndi="http://www.omg.org/spec/DMN/20180521/DMNDI/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:included1="https://kie.apache.org/dmn/_1B91A885-130A-4E0B-A762-E12AA6DD5C79" id="_A2B3C4D5-E6F7-8A9B-0C1D-2E3F4A5B6C7D" name="SelfSupportPropertyExclusion" typeLanguage="http://www.omg.org/spec/DMN/20180521/FEEL/" namespace="https://kie.apache.org/dmn/_F1A2B3C4-D5E6-7F8A-9B0C-1D2E3F4A5B6C">
  <dmn:extensionElements/>
  <dmn:import id="_B3C4D5E6-F7A8-9B0C-1D2E-3F4A5B6C7D8E" name="BDT" namespace="https://kie.apache.org/dmn/_1B91A885-130A-4E0B-A762-E12AA6DD5C79" locationURI="../../BDT.dmn" importType="http://www.omg.org/spec/DMN/20180521/MODEL/"/>
  <dmn:decision id="_C4D5E6F7-A8B9-0C1D-2E3F-4A5B6C7D8E9F" name="selfSupportTotal">
    <dmn:extensionElements/>
    <dmn:variable id="_D5E6F7A8-B9C0-1D2E-3F4A-5B6C7D8E9F0A" name="selfSupportTotal" typeRef="number"/>
    <dmn:informationRequirement id="_E6F7A8B9-C0D1-2E3F-4A5B-6C7D8E9F0A1B">
      <dmn:requiredInput href="#_F7A8B9C0-D1E2-3F4A-5B6C-7D8E9F0A1B2C"/>
    </dmn:informationRequirement>
    <dmn:literalExpression id="_A8B9C0D1-E2F3-4A5B-6C7D-8E9F0A1B2C3D">
      <dmn:text>sum(for r in resources return if r.isEssentialForSelfSupport = true then r.value else 0)</dmn:text>
    </dmn:literalExpression>
  </dmn:decision>
  <dmn:decision id="_B9C0D1E2-F3A4-5B6C-7D8E-9F0A1B2C3D4E" name="excludedAmount">
    <dmn:extensionElements/>
    <dmn:variable id="_C0D1E2F3-A4B5-6C7D-8E9F-0A1B2C3D4E5F" name="excludedAmount" typeRef="number"/>
    <dmn:informationRequirement id="_D1E2F3A4-B5C6-7D8E-9F0A-1B2C3D4E5F6A">
      <dmn:requiredDecision href="#_C4D5E6F7-A8B9-0C1D-2E3F-4A5B6C7D8E9F"/>
    </dmn:informationRequirement>
    <dmn:literalExpression id="_E2F3A4B5-C6D7-8E9F-0A1B-2C3D4E5F6A7B">
      <dmn:text>if selfSupportTotal &gt; 6000 then 6000 else selfSupportTotal</dmn:text>
    </dmn:literalExpression>
  </dmn:decision>
  <dmn:inputData id="_F7A8B9C0-D1E2-3F4A-5B6C-7D8E9F0A1B2C" name="resources">
    <dmn:extensionElements/>
    <dmn:variable id="_F3A4B5C6-D7E8-9F0A-1B2C-3D4E5F6A7B8C" name="resources" typeRef="BDT.tResourceList"/>
  </dmn:inputData>
  <dmn:decisionService id="_A4B5C6D7-E8F9-0A1B-2C3D-4E5F6A7B8C9D" name="SelfSupportPropertyExclusionService">
    <dmn:extensionElements/>
    <dmn:variable id="_B5C6D7E8-F9A0-1B2C-3D4E-5F6A7B8C9D0E" name="SelfSupportPropertyExclusionService" typeRef="Any"/>
    <dmn:outputDecision href="#_B9C0D1E2-F3A4-5B6C-7D8E-9F0A1B2C3D4E"/>
    <dmn:encapsulatedDecision href="#_C4D5E6F7-A8B9-0C1D-2E3F-4A5B6C7D8E9F"/>
    <dmn:inputData href="#_F7A8B9C0-D1E2-3F4A-5B6C-7D8E9F0A1B2C"/>
  </dmn:decisionService>
  <dmn:textAnnotation id="_C6D7E8F9-A0B1-2C3D-4E5F-6A7B8C9D0E1F" textFormat="text/plain">
    <dmn:text>SSI Self-Support Property Exclusion (POMS SI 01130.400)
Property essential for self-support excluded up to $6,000</dmn:text>
  </dmn:textAnnotation>
