    <dmn:literalExpression id="_B8C9D0E1-F2A3-4B5C-6D7E-8F9A0B1C2D3E">
      <dmn:text>resource.type = "life_insurance" and resource.lifeInsuranceFaceValue != null and resource.lifeInsuranceFaceValue &lt;= 1500</dmn:text>
    </dmn:literalExpression>
  </dmn:decision>
  <dmn:inputData id="_A7B8C9D0-E1F2-3A4B-5C6D-7E8F9A0B1C2D" name="resource">
