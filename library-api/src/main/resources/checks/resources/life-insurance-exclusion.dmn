  <dmn:decision id="_D4E5F6A7-B8C9-0D1E-2F3A-4B5C6D7E8F9A" name="isExcluded">
    <dmn:extensionElements/>
    <dmn:variable id="_E5F6A7B8-C9D0-1E2F-3A4B-5C6D7E8F9A0B" name="isExcluded" typeRef="boolean"/>
    <dmn:informationRequirement id="_F6A7B8C9-D0E1-2F3A-4B5C-6D7E8F9A0B1C">
      <dmn:requiredInput href="#_A7B8C9D0-E1F2-3A4B-5C6D-7E8F9A0B1C2D"/>
