  <dmn:textAnnotation id="_F2A3B4C5-D6E7-8F9A-0B1C-2D3E4F5A6B7C" textFormat="text/plain">
    <dmn:text>SSI Life Insurance Exclusion (POMS SI 01130.500)
Life insurance with face value ≤ $1,500 excluded</dmn:text>
