  <dmn:extensionElements/>
  <dmn:import id="_E3F4A5B6-C7D8-9E0F-1A2B-3C4D5E6F7A8B" name="BDT" namespace="https://kie.apache.org/dmn/_1B91A885-130A-4E0B-A762-E12AA6DD5C79" locationURI="../../BDT.dmn" importType="http://www.omg.org/spec/DMN/20180521/MODEL/"/>
  <dmn:decision id="_F4A5B6C7-D8E9-0F1A-2B3C-4D5E6F7A8B9C" name="excludedAmount">
    <dmn:extensionElements/>
    <dmn:variable id="_A5B6C7D8-E9F0-1A2B-3C4D-5E6F7A8B9C0D" name="excludedAmount" typeRef="number"/>
    <dmn:informationRequirement id="_B6C7D8E9-F0A1-2B3C-4D5E-6F7A8B9C0D1E">
      <dmn:requiredInput href="#_C7D8E9F0-A1B2-3C4D-5E6F-7A8B9C0D1E2F"/>
    </dmn:informationRequirement>
    <dmn:literalExpression id="_D8E9F0A1-B2C3-4D5E-6F7A-8B9C0D1E2F3A">
      <dmn:text>sum(for r in resources return if r.type = "vehicle" and r.isPrimaryVehicle = true then r.value else 0)</dmn:text>
    </dmn:literalExpression>
  </dmn:decision>
  <dmn:inputData id="_C7D8E9F0-A1B2-3C4D-5E6F-7A8B9C0D1E2F" name="resources">
    <dmn:extensionElements/>
    <dmn:variable id="_E9F0A1B2-C3D4-5E6F-7A8B-9C0D1E2F3A4B" name="resources" typeRef="BDT.tResourceList"/>
  </dmn:inputData>
  <dmn:decisionService id="_F0A1B2C3-D4E5-6F7A-8B9C-0D1E2F3A4B5C" name="VehicleExclusionService">
    <dmn:extensionElements/>
    <dmn:variable id="_A1B2C3D4-E5F6-7A8B-9C0D-1E2F3A4B5C6D" name="VehicleExclusionService" typeRef="Any"/>
    <dmn:outputDecision href="#_F4A5B6C7-D8E9-0F1A-2B3C-4D5E6F7A8B9C"/>
    <dmn:inputData href="#_C7D8E9F0-A1B2-3C4D-5E6F-7A8B9C0D1E2F"/>
  </dmn:decisionService>
  <dmn:textAnnotation id="_B2C3D4E5-F6A7-8B9C-0D1E-2F3A4B5C6D7E" textFormat="text/plain">
    <dmn:text>SSI Vehicle Exclusion (POMS SI 01130.300)
One automobile excluded if used for transportation</dmn:text>
  </dmn:textAnnotation>
