<?xml version="1.0" encoding="UTF-8"?>
<dmn:definitions xmlns:dmn="http://www.omg.org/spec/DMN/20180521/MODEL/" xmlns="https://kie.apache.org/dmn/_B1C2D3E4-F5A6-7B8C-9D0E-1F2A3B4C5D6E" xmlns:feel="http://www.omg.org/spec/DMN/20180521/FEEL/" xmlns:kie="http://www.drools.org/kie/dmn/1.2" xmlns:dmndi="http://www.omg.org/spec/DMN/20180521/DMNDI/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:BDT="https://kie.apache.org/dmn/_1B91A885-130A-4E0B-A762-E12AA6DD5C79" id="_C2D3E4F5-A6B7-8C9D-0E1F-2A3B4C5D6E7F" name="HouseholdGoodsExclusion" typeLanguage="http://www.omg.org/spec/DMN/20180521/FEEL/" namespace="https://kie.apache.org/dmn/_B1C2D3E4-F5A6-7B8C-9D0E-1F2A3B4C5D6E">
  <dmn:extensionElements/>
  <dmn:import id="_D3E4F5A6-B7C8-9D0E-1F2A-3B4C5D6E7F8A" name="BDT" namespace="https://kie.apache.org/dmn/_1B91A885-130A-4E0B-A762-E12AA6DD5C79" locationURI="../../BDT.dmn" importType="http://www.omg.org/spec/DMN/20180521/MODEL/"/>

  <!-- Define tParameters for this check -->
  <dmn:itemDefinition id="_hhg_tParameters" name="tParameters" isCollection="false">
    <dmn:itemComponent id="_hhg_tParameters_resources" name="resources" isCollection="false">
      <dmn:typeRef>BDT.tResourceList</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>

  <!-- Input: situation (standard check pattern) -->
  <dmn:inputData id="_hhg_situation_input" name="situation">
    <dmn:extensionElements/>
    <dmn:variable id="_hhg_situation_var" name="situation" typeRef="BDT.tSituation"/>
  </dmn:inputData>

  <!-- Input: parameters with resources list -->
  <dmn:inputData id="_hhg_parameters_input" name="parameters">
    <dmn:extensionElements/>
    <dmn:variable id="_hhg_parameters_var" name="parameters" typeRef="tParameters"/>
  </dmn:inputData>

  <!-- Decision: extract resources from parameters -->
  <dmn:decision id="_hhg_resources_decision" name="resources">
    <dmn:extensionElements/>
    <dmn:variable id="_hhg_resources_var" name="resources" typeRef="BDT.tResourceList"/>
    <dmn:informationRequirement id="_hhg_resources_req1">
      <dmn:requiredInput href="#_hhg_situation_input"/>
    </dmn:informationRequirement>
    <dmn:informationRequirement id="_hhg_resources_req2">
      <dmn:requiredInput href="#_hhg_parameters_input"/>
    </dmn:informationRequirement>
    <dmn:literalExpression id="_hhg_resources_expr">
      <dmn:text>if parameters.resources != null then parameters.resources else []</dmn:text>
    </dmn:literalExpression>
  </dmn:decision>

  <dmn:decision id="_E4F5A6B7-C8D9-0E1F-2A3B-4C5D6E7F8A9B" name="excludedAmount">
    <dmn:extensionElements/>
    <dmn:variable id="_F5A6B7C8-D9E0-1F2A-3B4C-5D6E7F8A9B0C" name="excludedAmount" typeRef="number"/>
    <dmn:informationRequirement id="_A6B7C8D9-E0F1-2A3B-4C5D-6E7F8A9B0C1D">
      <dmn:requiredDecision href="#_hhg_resources_decision"/>
    </dmn:informationRequirement>
    <dmn:literalExpression id="_C8D9E0F1-A2B3-4C5D-6E7F-8A9B0C1D2E3F">
      <dmn:text>if resources = null then 0 else sum(for r in resources return if r.type = "household_goods" then r.value else 0)</dmn:text>
    </dmn:literalExpression>
  </dmn:decision>

  <dmn:decision id="_hhg_checkResult_decision" name="checkResult">
    <dmn:description>Returns true if any household goods qualify for exclusion</dmn:description>
    <dmn:extensionElements/>
    <dmn:variable id="_hhg_checkResult_var" name="checkResult" typeRef="boolean"/>
    <dmn:informationRequirement id="_hhg_checkResult_req">
      <dmn:requiredDecision href="#_E4F5A6B7-C8D9-0E1F-2A3B-4C5D6E7F8A9B"/>
    </dmn:informationRequirement>
    <dmn:literalExpression id="_hhg_checkResult_expr">
      <dmn:text>excludedAmount > 0</dmn:text>
    </dmn:literalExpression>
  </dmn:decision>

  <dmn:decisionService id="_E0F1A2B3-C4D5-6E7F-8A9B-0C1D2E3F4A5B" name="HouseholdGoodsExclusionService">
    <dmn:extensionElements/>
    <dmn:variable id="_F1A2B3C4-D5E6-7F8A-9B0C-1D2E3F4A5B6C" name="HouseholdGoodsExclusionService" typeRef="BDT.tCheckResponse"/>
    <dmn:outputDecision href="#_hhg_checkResult_decision"/>
    <dmn:encapsulatedDecision href="#_E4F5A6B7-C8D9-0E1F-2A3B-4C5D6E7F8A9B"/>
    <dmn:encapsulatedDecision href="#_hhg_resources_decision"/>
    <dmn:inputData href="#_hhg_situation_input"/>
    <dmn:inputData href="#_hhg_parameters_input"/>
  </dmn:decisionService>

  <dmn:textAnnotation id="_A2B3C4D5-E6F7-8A9B-0C1D-2E3F4A5B6C7D" textFormat="text/plain">
    <dmn:text>SSI Household Goods Exclusion (POMS SI 01130.200)
Household goods and personal effects fully excluded</dmn:text>
  </dmn:textAnnotation>

  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="_B3C4D5E6-F7A8-9B0C-1D2E-3F4A5B6C7D8E" name="DRG">
      <di:extension>
        <kie:ComponentsWidthsExtension>
          <kie:ComponentWidths dmnElementRef="_C8D9E0F1-A2B3-4C5D-6E7F-8A9B0C1D2E3F">
            <kie:width>800</kie:width>
          </kie:ComponentWidths>
        </kie:ComponentsWidthsExtension>
      </di:extension>
      <dmndi:DMNShape id="dmnshape-drg-_hhg_situation_input" dmnElementRef="_hhg_situation_input" isCollapsed="false">
        <dmndi:DMNStyle>
          <dmndi:FillColor red="255" green="255" blue="255"/>
          <dmndi:StrokeColor red="0" green="0" blue="0"/>
          <dmndi:FontColor red="0" green="0" blue="0"/>
        </dmndi:DMNStyle>
        <dc:Bounds x="150" y="400" width="100" height="50"/>
        <dmndi:DMNLabel/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="dmnshape-drg-_hhg_parameters_input" dmnElementRef="_hhg_parameters_input" isCollapsed="false">
        <dmndi:DMNStyle>
          <dmndi:FillColor red="255" green="255" blue="255"/>
          <dmndi:StrokeColor red="0" green="0" blue="0"/>
          <dmndi:FontColor red="0" green="0" blue="0"/>
        </dmndi:DMNStyle>
        <dc:Bounds x="350" y="400" width="100" height="50"/>
        <dmndi:DMNLabel/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="dmnshape-drg-_E4F5A6B7-C8D9-0E1F-2A3B-4C5D6E7F8A9B" dmnElementRef="_E4F5A6B7-C8D9-0E1F-2A3B-4C5D6E7F8A9B" isCollapsed="false">
        <dmndi:DMNStyle>
          <dmndi:FillColor red="255" green="255" blue="255"/>
          <dmndi:StrokeColor red="0" green="0" blue="0"/>
          <dmndi:FontColor red="0" green="0" blue="0"/>
        </dmndi:DMNStyle>
        <dc:Bounds x="250" y="150" width="100" height="50"/>
        <dmndi:DMNLabel/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="dmnshape-drg-_E0F1A2B3-C4D5-6E7F-8A9B-0C1D2E3F4A5B" dmnElementRef="_E0F1A2B3-C4D5-6E7F-8A9B-0C1D2E3F4A5B" isCollapsed="false">
        <dmndi:DMNStyle>
          <dmndi:FillColor red="255" green="255" blue="255"/>
          <dmndi:StrokeColor red="0" green="0" blue="0"/>
          <dmndi:FontColor red="0" green="0" blue="0"/>
        </dmndi:DMNStyle>
        <dc:Bounds x="200" y="80" width="200" height="60"/>
        <dmndi:DMNLabel/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="dmnshape-drg-_A2B3C4D5-E6F7-8A9B-0C1D-2E3F4A5B6C7D" dmnElementRef="_A2B3C4D5-E6F7-8A9B-0C1D-2E3F4A5B6C7D" isCollapsed="false">
        <dmndi:DMNStyle fontSize="14">
          <dmndi:FillColor red="255" green="255" blue="255"/>
          <dmndi:StrokeColor red="0" green="0" blue="0"/>
          <dmndi:FontColor red="0" green="0" blue="0"/>
        </dmndi:DMNStyle>
        <dc:Bounds x="450" y="150" width="300" height="80"/>
        <dmndi:DMNLabel/>
      </dmndi:DMNShape>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</dmn:definitions>
