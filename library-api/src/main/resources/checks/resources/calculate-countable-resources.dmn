<?xml version="1.0" encoding="UTF-8"?>
<dmn:definitions xmlns:dmn="http://www.omg.org/spec/DMN/20180521/MODEL/" xmlns="https://kie.apache.org/dmn/_9A0B1C2D-3E4F-5A6B-7C8D-9E0F1A2B3C4D" xmlns:feel="http://www.omg.org/spec/DMN/20180521/FEEL/" xmlns:kie="http://www.drools.org/kie/dmn/1.2" xmlns:dmndi="http://www.omg.org/spec/DMN/20180521/DMNDI/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:BDT="https://kie.apache.org/dmn/_1B91A885-130A-4E0B-A762-E12AA6DD5C79" id="_0B1C2D3E-4F5A-6B7C-8D9E-0F1A2B3C4D5E" name="CalculateCountableResources" typeLanguage="http://www.omg.org/spec/DMN/20180521/FEEL/" namespace="https://kie.apache.org/dmn/_9A0B1C2D-3E4F-5A6B-7C8D-9E0F1A2B3C4D">
  <dmn:extensionElements/>
  <dmn:import id="_1C2D3E4F-5A6B-7C8D-9E0F-1A2B3C4D5E6F" name="BDT" namespace="https://kie.apache.org/dmn/_1B91A885-130A-4E0B-A762-E12AA6DD5C79" locationURI="../../BDT.dmn" importType="http://www.omg.org/spec/DMN/20180521/MODEL/"/>
  <dmn:inputData id="_9E0F1A2B-3C4D-5E6F-7A8B-9C0D1E2F3A4B" name="situation">
    <dmn:extensionElements/>
    <dmn:variable id="_0F1A2B3C-4D5E-6F7A-8B9C-0D1E2F3A4B5C" name="situation" typeRef="BDT.tSituation"/>
  </dmn:inputData>
  <dmn:inputData id="_1A2B3C4D-5E6F-7A8B-9C0D-1E2F3A4B5C6D" name="parameters">
    <dmn:extensionElements/>
    <dmn:variable id="_2B3C4D5E-6F7A-8B9C-0D1E-2F3A4B5C6D7E" name="parameters" typeRef="Any"/>
  </dmn:inputData>
  <dmn:decision id="_3C4D5E6F-7A8B-9C0D-1E2F-3A4B5C6D7E8F" name="resourceCalculation">
    <dmn:extensionElements/>
    <dmn:variable id="_4D5E6F7A-8B9C-0D1E-2F3A-4B5C6D7E8F9A" name="resourceCalculation" typeRef="BDT.tResourceCalculation"/>
    <dmn:informationRequirement id="_5E6F7A8B-9C0D-1E2F-3A4B-5C6D7E8F9A0B">
      <dmn:requiredInput href="#_9E0F1A2B-3C4D-5E6F-7A8B-9C0D1E2F3A4B"/>
    </dmn:informationRequirement>
    <dmn:informationRequirement id="_6F7A8B9C-0D1E-2F3A-4B5C-6D7E8F9A0B1C">
      <dmn:requiredInput href="#_1A2B3C4D-5E6F-7A8B-9C0D-1E2F3A4B5C6D"/>
    </dmn:informationRequirement>
    <dmn:context id="_7A8B9C0D-1E2F-3A4B-5C6D-7E8F9A0B1C2D">
      <dmn:contextEntry>
        <dmn:variable id="_8B9C0D1E-2F3A-4B5C-6D7E-8F9A0B1C2D3E" name="person" typeRef="BDT.tPerson"/>
        <dmn:literalExpression id="_9C0D1E2F-3A4B-5C6D-7E8F-9A0B1C2D3E4F">
          <dmn:text>situation.people[id = parameters.personId]</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_0D1E2F3A-4B5C-6D7E-8F9A-0B1C2D3E4F5A" name="resources" typeRef="BDT.tResourceList"/>
        <dmn:literalExpression id="_1E2F3A4B-5C6D-7E8F-9A0B-1C2D3E4F5A6B">
          <dmn:text>if parameters.resources = null then [] else parameters.resources</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_2F3A4B5C-6D7E-8F9A-0B1C-2D3E4F5A6B7C" name="totalResources" typeRef="number"/>
        <dmn:literalExpression id="_3A4B5C6D-7E8F-9A0B-1C2D-3E4F5A6B7C8D">
          <dmn:text>if resources = null then 0 else sum(for r in resources return r.value)</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_4B5C6D7E-8F9A-0B1C-2D3E-4F5A6B7C8D9E" name="homeExcluded" typeRef="number"/>
        <dmn:literalExpression id="_5C6D7E8F-9A0B-1C2D-3E4F-5A6B7C8D9E0F">
          <dmn:text>if resources = null then 0 else sum(for r in resources return if r.type = "real_property" and r.isPrimaryResidence = true then r.value else 0)</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_6D7E8F9A-0B1C-2D3E-4F5A-6B7C8D9E0F1A" name="lifeInsuranceExcluded" typeRef="number"/>
        <dmn:literalExpression id="_7E8F9A0B-1C2D-3E4F-5A6B-7C8D9E0F1A2B">
          <dmn:text>if resources = null then 0 else sum(for r in resources return if r.type = "life_insurance" and r.lifeInsuranceFaceValue != null and r.lifeInsuranceFaceValue &lt;= 1500 then r.value else 0)</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_8F9A0B1C-2D3E-4F5A-6B7C-8D9E0F1A2B3C" name="householdGoodsExcluded" typeRef="number"/>
        <dmn:literalExpression id="_9A0B1C2D-3E4F-5A6B-7C8D-9E0F1A2B3C4D">
          <dmn:text>if resources = null then 0 else sum(for r in resources return if r.type = "household_goods" then r.value else 0)</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_F950793E-F299-435C-AE93-159058BEFFBE" name="vehicleExcluded" typeRef="number"/>
        <dmn:literalExpression id="_AD138B55-A813-46F5-87CE-BAD6DDF1FEBD">
          <dmn:text>if resources = null then 0 else sum(for r in resources return if r.type = "vehicle" and r.isPrimaryVehicle = true then r.value else 0)</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_2C3D4E5F-6A7B-8C9D-0E1F-2A3B4C5D6E7F" name="burialFundsTotal" typeRef="number"/>
        <dmn:literalExpression id="_3D4E5F6A-7B8C-9D0E-1F2A-3B4C5D6E7F8A">
          <dmn:text>if resources = null then 0 else sum(for r in resources return if r.type = "burial_fund" then r.value else 0)</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_4E5F6A7B-8C9D-0E1F-2A3B-4C5D6E7F8A9B" name="burialFundExcluded" typeRef="number"/>
        <dmn:literalExpression id="_5F6A7B8C-9D0E-1F2A-3B4C-5D6E7F8A9B0C">
          <dmn:text>if burialFundsTotal &gt; 1500 then 1500 else burialFundsTotal</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_6A7B8C9D-0E1F-2A3B-4C5D-6E7F8A9B0C1D" name="ableAccountsTotal" typeRef="number"/>
        <dmn:literalExpression id="_7B8C9D0E-1F2A-3B4C-5D6E-7F8A9B0C1D2E">
          <dmn:text>if resources = null then 0 else sum(for r in resources return if r.type = "able_account" then r.value else 0)</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_8C9D0E1F-2A3B-4C5D-6E7F-8A9B0C1D2E3F" name="ableAccountExcluded" typeRef="number"/>
        <dmn:literalExpression id="_9D0E1F2A-3B4C-5D6E-7F8A-9B0C1D2E3F4A">
          <dmn:text>if ableAccountsTotal &gt; 100000 then 100000 else ableAccountsTotal</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_0E1F2A3B-4C5D-6E7F-8A9B-0C1D2E3F4A5B" name="selfSupportTotal" typeRef="number"/>
        <dmn:literalExpression id="_1F2A3B4C-5D6E-7F8A-9B0C-1D2E3F4A5B6C">
          <dmn:text>if resources = null then 0 else sum(for r in resources return if r.isEssentialForSelfSupport = true then r.value else 0)</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_2A3B4C5D-6E7F-8A9B-0C1D-2E3F4A5B6C7D" name="selfSupportPropertyExcluded" typeRef="number"/>
        <dmn:literalExpression id="_3B4C5D6E-7F8A-9B0C-1D2E-3F4A5B6C7D8E">
          <dmn:text>if selfSupportTotal &gt; 6000 then 6000 else selfSupportTotal</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_C51AAA66-55D0-483A-81E2-1A1BF3EB075F" name="totalExcluded" typeRef="number"/>
        <dmn:literalExpression id="_5899DA03-5A71-4B87-A965-349A65435729">
          <dmn:text>homeExcluded + lifeInsuranceExcluded + householdGoodsExcluded + vehicleExcluded + burialFundExcluded + ableAccountExcluded + selfSupportPropertyExcluded</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_FB4D6B7A-C03B-490E-A7E1-CA531F01AE26" name="countableResources" typeRef="number"/>
        <dmn:literalExpression id="_8B37A391-7017-4998-ADC4-36936D9F1471">
          <dmn:text>totalResources - totalExcluded</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_F656371C-F396-4B71-A709-472EED88057F" name="hasEligibleSpouse" typeRef="boolean"/>
        <dmn:literalExpression id="_2B47DCF3-6B78-443E-AF24-19616236E43C">
          <dmn:text>count(situation.relationships[personId = parameters.personId and type = "spouse"]) &gt; 0</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_52FD77B7-7044-4B82-B9B3-084B02EE5169" name="applicableLimit" typeRef="number"/>
        <dmn:literalExpression id="_94A9BE93-2A85-456C-A1EE-B4241019D6E3">
          <dmn:text>if hasEligibleSpouse then 3000 else 2000</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:literalExpression id="_276E829B-9EC0-45B8-8CA1-9494D5E987EE">
          <dmn:text>{
  totalResources: totalResources,
  excludedResources: totalExcluded,
  countableResources: countableResources,
  applicableLimit: applicableLimit,
  meetsResourceLimit: countableResources &lt; applicableLimit
}</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
    </dmn:context>
  </dmn:decision>
  <dmn:decisionService id="_764398D0-9DE2-4546-96EE-B0C9850A36F6" name="CalculateCountableResourcesService">
    <dmn:extensionElements/>
    <dmn:variable id="_75238DF8-7498-4403-B49D-E59E7B49D9A5" name="CalculateCountableResourcesService" typeRef="Any"/>
    <dmn:outputDecision href="#_3C4D5E6F-7A8B-9C0D-1E2F-3A4B5C6D7E8F"/>
    <dmn:inputData href="#_9E0F1A2B-3C4D-5E6F-7A8B-9C0D1E2F3A4B"/>
    <dmn:inputData href="#_1A2B3C4D-5E6F-7A8B-9C0D-1E2F3A4B5C6D"/>
  </dmn:decisionService>
  <dmn:textAnnotation id="_4C5D6E7F-8A9B-0C1D-2E3F-4A5B6C7D8E9F" textFormat="text/plain">
    <dmn:text>SSI Resource Calculation (POMS SI 01110-01150)
Calculates countable resources after applying exclusions:
- Home (SI 01130.100): Primary residence
- Life Insurance (SI 01130.500): Face value ≤ $1,500
- Household Goods (SI 01130.200): All household goods
- Vehicle (SI 01130.200): Primary vehicle
- Burial Fund (SI 01130.400): Up to $1,500
- ABLE Account (SI 01130.740): Up to $100,000
- Self-Support Property (SI 01130.515): Up to $6,000</dmn:text>
  </dmn:textAnnotation>
