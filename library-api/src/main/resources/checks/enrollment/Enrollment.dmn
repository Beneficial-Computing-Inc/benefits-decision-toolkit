<?xml version="1.0" encoding="UTF-8"?>
<dmn:definitions xmlns:dmn="https://www.omg.org/spec/DMN/20240513/MODEL/" xmlns="https://kie.apache.org/dmn/_6E9D53A6-E99A-4060-9E3E-1AE12EAB5465" xmlns:feel="https://www.omg.org/spec/DMN/20240513/FEEL/" xmlns:kie="https://kie.org/dmn/extensions/1.0" xmlns:dmndi="https://www.omg.org/spec/DMN/20230324/DMNDI/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" id="_CCB44031-5ABF-4677-97E8-924CF1150236" name="Enrollment" typeLanguage="https://www.omg.org/spec/DMN/20240513/FEEL/" namespace="https://kie.apache.org/dmn/_6E9D53A6-E99A-4060-9E3E-1AE12EAB5465">
  <dmn:extensionElements/>
  <dmn:itemDefinition id="_853E7CDE-4938-4FF2-88BD-9CA645F9A792" name="tEnrollment" isCollection="false">
    <dmn:description>Represents enrollment in a benefit program. Extended to support income interactions per POMS SI 00830.

Benefit codes: SSDI, SSA_RETIREMENT, SSA_SURVIVORS, VA_PENSION, VA_DISABILITY_COMP, WORKERS_COMP,
RAILROAD_RETIREMENT, BLACK_LUNG, UNEMPLOYMENT, PRIVATE_PENSION, SECTION_8, SNAP, LIHEAP, WIC,
SCHOOL_LUNCH, MEDICAID, MEDICARE, SSI, CHIP, STATE_VET_ANNUITY, DISASTER_RELIEF</dmn:description>
    <dmn:itemComponent id="_76F6D3C7-878D-4E4E-B571-D3FA033C9CAE" name="personId" isCollection="false">
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_91AA206A-90FC-4464-8299-90AABCD8E3D2" name="benefit" isCollection="false">
      <dmn:description>Benefit type code (e.g., SSDI, VA_PENSION, SECTION_8, SNAP). See taxonomy in description above.</dmn:description>
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_INC1_2026_0126_STATUS" name="status" isCollection="false">
      <dmn:description>Enrollment status: RECEIVING, PENDING, APPROVED, DENIED. Optional - defaults to RECEIVING if not specified.</dmn:description>
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_INC1_2026_0126_AMOUNT" name="monthlyAmount" isCollection="false">
      <dmn:description>Monthly benefit amount in dollars. Required for cash benefits (SSDI, VA, etc.) to calculate income. Optional for non-cash benefits (SNAP, Medicaid).</dmn:description>
      <dmn:typeRef>number</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_INC1_2026_0126_START" name="startDate" isCollection="false">
      <dmn:description>Date benefit started. Used for time-based calculations (e.g., SSDI 24-month wait for Medicare per POMS HI 00801.002).</dmn:description>
      <dmn:typeRef>date</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:itemDefinition id="_F27E2E28-2B1D-4399-A66B-88AD5F9F3D0C" name="tEnrollmentList" isCollection="true">
    <dmn:typeRef>tEnrollment</dmn:typeRef>
  </dmn:itemDefinition>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="_4DB609BE-1BEA-4836-AEF5-1FC86E4CA585" name="DRG">
      <di:extension>
        <kie:ComponentsWidthsExtension/>
      </di:extension>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</dmn:definitions>