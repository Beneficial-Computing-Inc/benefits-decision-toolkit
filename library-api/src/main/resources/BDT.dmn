    <dmn:itemComponent id="_SEIE002-2026-0112-SEIE-EXCLUSIONAPPLIED" name="seieExclusionApplied" isCollection="false">
      <dmn:description>POMS SI 00820.510 - Student Earned Income Exclusion amount applied this month</dmn:description>
      <dmn:typeRef>number</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_DEEM002-2026-0112-DEEM-DEEMEDINCOME" name="deemedIncome" isCollection="false">
      <dmn:description>POMS SI 01320.000 - Income deemed from ineligible spouse or parent(s)</dmn:description>
      <dmn:typeRef>number</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:itemDefinition id="_DEEM003-2026-0112-DEEM-DEEMINGCALC" name="tDeemingCalculation" isCollection="false">
    <dmn:description>POMS SI 01320.000 - Deeming calculation results showing income deemed from ineligible household members</dmn:description>
    <dmn:itemComponent id="_DEEM004-2026-0112-DEEM-APPLIES" name="deemingApplies" isCollection="false">
      <dmn:description>Whether deeming applies to this person based on household composition</dmn:description>
      <dmn:typeRef>boolean</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_DEEM005-2026-0112-DEEM-TYPE" name="deemingType" isCollection="false">
      <dmn:description>Type of deeming: "spouse" (SI 01320.400), "parent" (SI 01320.500), or "none"</dmn:description>
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_DEEM006-2026-0112-DEEM-DEEMORINCOME" name="deemorTotalIncome" isCollection="false">
      <dmn:description>Total gross income of deemor(s) before exclusions</dmn:description>
      <dmn:typeRef>number</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_DEEM007-2026-0112-DEEM-COUNTABLE" name="deemorCountableIncome" isCollection="false">
      <dmn:description>Countable income of deemor(s) after applying standard exclusions</dmn:description>
      <dmn:typeRef>number</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_DEEM008-2026-0112-DEEM-LIVINGALLOC" name="livingAllowanceAllocated" isCollection="false">
      <dmn:description>Amount allocated for deemor(s)' living allowance per SI 01320.400/.500</dmn:description>
      <dmn:typeRef>number</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_DEEM009-2026-0112-DEEM-CHILDALLOC" name="ineligibleChildrenAllocation" isCollection="false">
      <dmn:description>SI 01320.500 - Amount allocated for ineligible children in household (1/2 FBR each)</dmn:description>
      <dmn:typeRef>number</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_DEEM010-2026-0112-DEEM-DEEMED" name="deemedIncome" isCollection="false">
      <dmn:description>Final income deemed to eligible person after all allocations</dmn:description>
      <dmn:typeRef>number</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_DEEM011-2026-0112-DEEM-NUMCHILDREN" name="numberOfIneligibleChildren" isCollection="false">
      <dmn:description>Count of ineligible children in household for allocation calculation</dmn:description>
      <dmn:typeRef>number</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_DEEM012-2026-0112-DEEM-NUMPARENTS" name="numberOfParents" isCollection="false">
      <dmn:description>Count of parents in household (1 or 2) for parent deeming allocation</dmn:description>
      <dmn:typeRef>number</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
