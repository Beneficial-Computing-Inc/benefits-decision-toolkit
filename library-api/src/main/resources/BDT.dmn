  <dmn:itemDefinition id="_47681CD3-2FA0-4694-B03B-F381DA457BD3" name="tPerson" isCollection="false">
    <dmn:itemComponent id="_CAC97D8B-FF24-4C38-8F32-C1507705112D" name="dateOfBirth" isCollection="false">
      <dmn:typeRef>date</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_7899544D-D4BF-43E1-BB0C-61E13BBB14B2" name="id" isCollection="false">
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_1D39B4A8-5079-44C9-BCE1-E58D5C8FB677" name="citizenshipStatus" isCollection="false">
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_SSDI002-2026-0115-DISAB-ISDISABLED" name="isDisabled" isCollection="false">
      <dmn:description>POMS DI 10105.065 - Whether person has a medically determinable physical or mental impairment expected to last 12+ months or result in death, and is unable to engage in SGA. Used for SSI categorical eligibility and SSDI disability requirement.</dmn:description>
      <dmn:typeRef>boolean</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_BDT004-2026-0206-DISAB-ONSETDATE" name="disabilityOnsetDate" isCollection="false">
      <dmn:description>POMS DI 10105.065 - Date disability began. Used with expectedDisabilityDuration for duration requirement check. Nullable - optional for screener use.</dmn:description>
      <dmn:typeRef>date</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_BDT004-2026-0206-DISAB-EXPDURATION" name="expectedDisabilityDuration" isCollection="false">
      <dmn:description>POMS DI 10105.065 - Expected duration of disability. Valid values: "12_MONTHS_OR_MORE", "LESS_THAN_12_MONTHS", "EXPECTED_TO_RESULT_IN_DEATH". Nullable - when null, system falls back to just checking isDisabled. Note: Statutory blindness (isBlind) has NO duration requirement per POMS DI 10501.015.</dmn:description>
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_007C0A99-0361-48A3-A52B-4FAECB30663E" name="refugeeAdmissionDate" isCollection="false">
      <dmn:typeRef>date</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_31B4A7B3-8F80-4935-9937-720279C568AE" name="asylumGrantDate" isCollection="false">
      <dmn:typeRef>date</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_31A04A0E-5DFD-42B1-B8F7-97BA56FCD078" name="withheldDeportationGrantDate" isCollection="false">
      <dmn:typeRef>date</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_2F229E87-6FEA-4FB4-BF12-778F21E898F0" name="cubanHaitianEntryDate" isCollection="false">
      <dmn:typeRef>date</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_B520F043-1947-4E5A-922B-117450F6BAA7" name="amerasianAdmissionDate" isCollection="false">
      <dmn:typeRef>date</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_5E7A9F2C-8B3D-4E1A-9C6F-2D8B4A7E3C5F" name="residenceState" isCollection="false">
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_9A8B7C6D-5E4F-3A2B-1C9D-8E7F6A5B4C3D" name="resources" isCollection="false">
      <dmn:typeRef>tResourceList</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_1F2E3D4C-5B6A-7980-1234-567890ABCDEF" name="incomeSources" isCollection="false">
      <dmn:typeRef>tIncomeSourceList</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_SEIE001-2026-0112-STUD-ISREGULARSTUD" name="isStudent" isCollection="false">
      <dmn:description>POMS SI 00501.020 - Whether person is regularly attending school, college, or job training per student requirements for SEIE</dmn:description>
      <dmn:typeRef>boolean</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_DEEM001-2026-0112-ELIG-ISSSIELIGIBLE" name="isSSIEligible" isCollection="false">
      <dmn:description>POMS SI 01320.000 - Whether person meets basic SSI eligibility (age/blind/disabled, citizenship, residence). Used to identify ineligible spouse/parent/child for deeming.</dmn:description>
      <dmn:typeRef>boolean</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_SSDI001-2026-0115-BLIND-ISBLIND" name="isBlind" isCollection="false">
      <dmn:description>POMS DI 10501.015 - Whether person meets statutory blindness definition. Used for SSDI SGA threshold selection (blind: $2,700/month vs non-blind: $1,620/month in 2025). Note: Blind individuals under Title XVI (SSI) are NOT subject to SGA limitations.</dmn:description>
      <dmn:typeRef>boolean</dmn:typeRef>
    </dmn:itemComponent>
    <!-- LPR Exception Condition Fields - POMS SI 00502.100A.3 -->
    <dmn:itemComponent id="_LPR001-2026-0115-QQ-QUALIFYINGQUARTERS" name="qualifyingQuarters" isCollection="false">
      <dmn:description>POMS SI 00502.135 - Total qualifying quarters (QQ) of earnings. Includes own QQs, parent's QQs (while under 18), and spouse's QQs (during marriage). 40 QQs required for LAPR exception.</dmn:description>
      <dmn:typeRef>number</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_LPR002-2026-0115-ENTRY-USENTRYDATE" name="usEntryDate" isCollection="false">
      <dmn:description>POMS SI 00502.135B.1 - Date of entry into US as a qualified alien. Used for 5-year bar calculation for LAPRs entering on/after 8/22/96.</dmn:description>
      <dmn:typeRef>date</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_LPR003-2026-0115-VET-ISVETERAN" name="isVeteran" isCollection="false">
      <dmn:description>POMS SI 00502.140 - Whether person is a veteran (honorably discharged, 2+ years active duty or equivalent).</dmn:description>
      <dmn:typeRef>boolean</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_LPR004-2026-0115-MIL-ISACTIVEDUTYMILITARY" name="isActiveDutyMilitary" isCollection="false">
      <dmn:description>POMS SI 00502.140A.2 - Whether person is currently on active duty in US Armed Forces.</dmn:description>
      <dmn:typeRef>boolean</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_LPR005-2026-0115-VETSP-ISSPOUSEOFVETERAN" name="isSpouseOfVeteranOrActiveDuty" isCollection="false">
      <dmn:description>POMS SI 00502.140A.5 - Whether person is spouse of veteran or active duty service member (includes unremarried surviving spouse).</dmn:description>
      <dmn:typeRef>boolean</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_LPR006-2026-0115-VETCH-ISDEPENDENTCHILDOFVETERAN" name="isDependentChildOfVeteranOrActiveDuty" isCollection="false">
      <dmn:description>POMS SI 00502.140A.6 - Whether person is unmarried dependent child (under 18, or under 22 if student) of veteran or active duty service member.</dmn:description>
      <dmn:typeRef>boolean</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_LPR007-2026-0115-RES96-WASLAWFULLYRESIDING8221996" name="wasLawfullyResidingOn8221996" isCollection="false">
      <dmn:description>POMS SI 00502.142B.2 - Whether person was lawfully residing in US on 8/22/96. Required for blind/disabled LAPR exception.</dmn:description>
      <dmn:typeRef>boolean</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_LPR008-2026-0115-SSI96-WASRECEIVINGSSI8221996" name="wasReceivingSSIOn8221996" isCollection="false">
      <dmn:description>POMS SI 00502.100A.1 - Whether person was receiving SSI benefits on 8/22/96 (grandfathered eligibility).</dmn:description>
      <dmn:typeRef>boolean</dmn:typeRef>
    </dmn:itemComponent>
    <!-- SSDI Work Credits Fields - POMS DI 10105.060, RS 00301.120 -->
    <dmn:itemComponent id="_SSDI003-2026-0115-WORK-HASWORKED" name="hasWorkedAndPaidSSTaxes" isCollection="false">
      <dmn:description>POMS DI 10105.060 - Whether person has ever worked and paid Social Security taxes. Basic requirement for SSDI eligibility.</dmn:description>
      <dmn:typeRef>boolean</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_SSDI004-2026-0115-WORK-YEARSLAST10" name="yearsWorkedInLast10Years" isCollection="false">
      <dmn:description>RS 00301.120 - Approximate years worked in the last 10 years. Used for Recent Work Test: need ~5 years for ages 31+. Also used for young worker rules.</dmn:description>
      <dmn:typeRef>number</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_SSDI005-2026-0318-WORK-TOTALYEARS" name="approximateYearsWorked" isCollection="false">
      <dmn:description>RS 00301.120 / ssa.gov/benefits/retirement/planner/credits - Approximate total years of lifetime US work. Used for Duration of Work Test (separate from the Recent Work Test).</dmn:description>
      <dmn:typeRef>number</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
