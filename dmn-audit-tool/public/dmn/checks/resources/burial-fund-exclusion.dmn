<?xml version="1.0" encoding="UTF-8"?>
<dmn:definitions xmlns:dmn="http://www.omg.org/spec/DMN/20180521/MODEL/" xmlns="https://kie.apache.org/dmn/_D1E2F3A4-B5C6-7D8E-9F0A-1B2C3D4E5F6A" xmlns:feel="http://www.omg.org/spec/DMN/20180521/FEEL/" xmlns:kie="http://www.drools.org/kie/dmn/1.2" xmlns:dmndi="http://www.omg.org/spec/DMN/20180521/DMNDI/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:BDT="https://kie.apache.org/dmn/_1B91A885-130A-4E0B-A762-E12AA6DD5C79" id="_E2F3A4B5-C6D7-8E9F-0A1B-2C3D4E5F6A7B" name="BurialFundExclusion" typeLanguage="http://www.omg.org/spec/DMN/20180521/FEEL/" namespace="https://kie.apache.org/dmn/_D1E2F3A4-B5C6-7D8E-9F0A-1B2C3D4E5F6A">
  <dmn:extensionElements/>
  <dmn:import id="_F3A4B5C6-D7E8-9F0A-1B2C-3D4E5F6A7B8C" name="BDT" namespace="https://kie.apache.org/dmn/_1B91A885-130A-4E0B-A762-E12AA6DD5C79" locationURI="../../BDT.dmn" importType="http://www.omg.org/spec/DMN/20180521/MODEL/"/>

  <!-- Define tParameters for this check -->
  <dmn:itemDefinition id="_burial_tParameters" name="tParameters" isCollection="false">
    <dmn:itemComponent id="_burial_tParameters_resources" name="resources" isCollection="false">
      <dmn:typeRef>BDT.tResourceList</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>

  <!-- Input: situation (standard check pattern) -->
  <dmn:inputData id="_burial_situation_input" name="situation">
    <dmn:extensionElements/>
    <dmn:variable id="_burial_situation_var" name="situation" typeRef="BDT.tSituation"/>
  </dmn:inputData>

  <!-- Input: parameters with resources list -->
  <dmn:inputData id="_burial_parameters_input" name="parameters">
    <dmn:extensionElements/>
    <dmn:variable id="_burial_parameters_var" name="parameters" typeRef="tParameters"/>
  </dmn:inputData>

  <!-- Decision: extract resources from person -->
  <dmn:decision id="_burial_resources_decision" name="resources">
    <dmn:extensionElements/>
    <dmn:variable id="_burial_resources_var" name="resources" typeRef="BDT.tResourceList"/>
    <dmn:informationRequirement id="_burial_resources_req1">
      <dmn:requiredInput href="#_burial_situation_input"/>
    </dmn:informationRequirement>
    <dmn:informationRequirement id="_burial_resources_req2">
      <dmn:requiredInput href="#_burial_parameters_input"/>
    </dmn:informationRequirement>
    <dmn:literalExpression id="_burial_resources_expr">
      <dmn:text>if parameters.resources != null then parameters.resources else []</dmn:text>
    </dmn:literalExpression>
  </dmn:decision>

  <dmn:decision id="_A4B5C6D7-E8F9-0A1B-2C3D-4E5F6A7B8C9D" name="burialFundsTotal">
    <dmn:extensionElements/>
    <dmn:variable id="_B5C6D7E8-F9A0-1B2C-3D4E-5F6A7B8C9D0E" name="burialFundsTotal" typeRef="number"/>
    <dmn:informationRequirement id="_C6D7E8F9-A0B1-2C3D-4E5F-6A7B8C9D0E1F">
      <dmn:requiredDecision href="#_burial_resources_decision"/>
    </dmn:informationRequirement>
    <dmn:literalExpression id="_E8F9A0B1-C2D3-4E5F-6A7B-8C9D0E1F2A3B">
      <dmn:text>if resources = null then 0 else sum(for r in resources return if r.type = "burial_fund" then r.value else 0)</dmn:text>
    </dmn:literalExpression>
  </dmn:decision>

  <dmn:decision id="_F9A0B1C2-D3E4-5F6A-7B8C-9D0E1F2A3B4C" name="excludedAmount">
    <dmn:extensionElements/>
    <dmn:variable id="_A0B1C2D3-E4F5-6A7B-8C9D-0E1F2A3B4C5D" name="excludedAmount" typeRef="number"/>
    <dmn:informationRequirement id="_B1C2D3E4-F5A6-7B8C-9D0E-1F2A3B4C5D6E">
      <dmn:requiredDecision href="#_A4B5C6D7-E8F9-0A1B-2C3D-4E5F6A7B8C9D"/>
    </dmn:informationRequirement>
    <dmn:literalExpression id="_C2D3E4F5-A6B7-8C9D-0E1F-2A3B4C5D6E7F">
      <dmn:text>if burialFundsTotal &gt; 1500 then 1500 else burialFundsTotal</dmn:text>
    </dmn:literalExpression>
  </dmn:decision>

  <dmn:decision id="_checkResult_decision" name="checkResult">
    <dmn:description>Returns true if any burial funds qualify for exclusion</dmn:description>
    <dmn:extensionElements/>
    <dmn:variable id="_checkResult_var" name="checkResult" typeRef="boolean"/>
    <dmn:informationRequirement id="_checkResult_req">
      <dmn:requiredDecision href="#_F9A0B1C2-D3E4-5F6A-7B8C-9D0E1F2A3B4C"/>
    </dmn:informationRequirement>
    <dmn:literalExpression id="_checkResult_expr">
      <dmn:text>excludedAmount > 0</dmn:text>
    </dmn:literalExpression>
  </dmn:decision>

  <dmn:decisionService id="_E4F5A6B7-C8D9-0E1F-2A3B-4C5D6E7F8A9B" name="BurialFundExclusionService">
    <dmn:extensionElements/>
    <dmn:variable id="_F5A6B7C8-D9E0-1F2A-3B4C-5D6E7F8A9B0C" name="BurialFundExclusionService" typeRef="BDT.tCheckResponse"/>
    <dmn:outputDecision href="#_checkResult_decision"/>
    <dmn:encapsulatedDecision href="#_F9A0B1C2-D3E4-5F6A-7B8C-9D0E1F2A3B4C"/>
    <dmn:encapsulatedDecision href="#_A4B5C6D7-E8F9-0A1B-2C3D-4E5F6A7B8C9D"/>
    <dmn:encapsulatedDecision href="#_burial_resources_decision"/>
    <dmn:inputData href="#_burial_situation_input"/>
    <dmn:inputData href="#_burial_parameters_input"/>
  </dmn:decisionService>

  <dmn:textAnnotation id="_A6B7C8D9-E0F1-2A3B-4C5D-6E7F8A9B0C1D" textFormat="text/plain">
    <dmn:text>SSI Burial Fund Exclusion (POMS SI 01130.600)
Up to $1,500 per person in designated burial funds</dmn:text>
  </dmn:textAnnotation>

  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="_B7C8D9E0-F1A2-3B4C-5D6E-7F8A9B0C1D2E" name="DRG">
      <di:extension>
        <kie:ComponentsWidthsExtension>
          <kie:ComponentWidths dmnElementRef="_E8F9A0B1-C2D3-4E5F-6A7B-8C9D0E1F2A3B">
            <kie:width>800</kie:width>
          </kie:ComponentWidths>
          <kie:ComponentWidths dmnElementRef="_C2D3E4F5-A6B7-8C9D-0E1F-2A3B4C5D6E7F">
            <kie:width>800</kie:width>
          </kie:ComponentWidths>
        </kie:ComponentsWidthsExtension>
      </di:extension>
      <dmndi:DMNShape id="dmnshape-drg-_burial_situation_input" dmnElementRef="_burial_situation_input" isCollapsed="false">
        <dmndi:DMNStyle>
          <dmndi:FillColor red="255" green="255" blue="255"/>
          <dmndi:StrokeColor red="0" green="0" blue="0"/>
          <dmndi:FontColor red="0" green="0" blue="0"/>
        </dmndi:DMNStyle>
        <dc:Bounds x="150" y="400" width="100" height="50"/>
        <dmndi:DMNLabel/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="dmnshape-drg-_burial_parameters_input" dmnElementRef="_burial_parameters_input" isCollapsed="false">
        <dmndi:DMNStyle>
          <dmndi:FillColor red="255" green="255" blue="255"/>
          <dmndi:StrokeColor red="0" green="0" blue="0"/>
          <dmndi:FontColor red="0" green="0" blue="0"/>
        </dmndi:DMNStyle>
        <dc:Bounds x="350" y="400" width="100" height="50"/>
        <dmndi:DMNLabel/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="dmnshape-drg-_A4B5C6D7-E8F9-0A1B-2C3D-4E5F6A7B8C9D" dmnElementRef="_A4B5C6D7-E8F9-0A1B-2C3D-4E5F6A7B8C9D" isCollapsed="false">
        <dmndi:DMNStyle>
          <dmndi:FillColor red="255" green="255" blue="255"/>
          <dmndi:StrokeColor red="0" green="0" blue="0"/>
          <dmndi:FontColor red="0" green="0" blue="0"/>
        </dmndi:DMNStyle>
        <dc:Bounds x="250" y="230" width="100" height="50"/>
        <dmndi:DMNLabel/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="dmnshape-drg-_F9A0B1C2-D3E4-5F6A-7B8C-9D0E1F2A3B4C" dmnElementRef="_F9A0B1C2-D3E4-5F6A-7B8C-9D0E1F2A3B4C" isCollapsed="false">
        <dmndi:DMNStyle>
          <dmndi:FillColor red="255" green="255" blue="255"/>
          <dmndi:StrokeColor red="0" green="0" blue="0"/>
          <dmndi:FontColor red="0" green="0" blue="0"/>
        </dmndi:DMNStyle>
        <dc:Bounds x="250" y="150" width="100" height="50"/>
        <dmndi:DMNLabel/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="dmnshape-drg-_E4F5A6B7-C8D9-0E1F-2A3B-4C5D6E7F8A9B" dmnElementRef="_E4F5A6B7-C8D9-0E1F-2A3B-4C5D6E7F8A9B" isCollapsed="false">
        <dmndi:DMNStyle>
          <dmndi:FillColor red="255" green="255" blue="255"/>
          <dmndi:StrokeColor red="0" green="0" blue="0"/>
          <dmndi:FontColor red="0" green="0" blue="0"/>
        </dmndi:DMNStyle>
        <dc:Bounds x="200" y="80" width="200" height="60"/>
        <dmndi:DMNLabel/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="dmnshape-drg-_A6B7C8D9-E0F1-2A3B-4C5D-6E7F8A9B0C1D" dmnElementRef="_A6B7C8D9-E0F1-2A3B-4C5D-6E7F8A9B0C1D" isCollapsed="false">
        <dmndi:DMNStyle fontSize="14">
          <dmndi:FillColor red="255" green="255" blue="255"/>
          <dmndi:StrokeColor red="0" green="0" blue="0"/>
          <dmndi:FontColor red="0" green="0" blue="0"/>
        </dmndi:DMNStyle>
        <dc:Bounds x="450" y="150" width="300" height="80"/>
        <dmndi:DMNLabel/>
      </dmndi:DMNShape>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</dmn:definitions>
