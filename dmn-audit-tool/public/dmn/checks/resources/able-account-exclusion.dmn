<?xml version="1.0" encoding="UTF-8"?>
<dmn:definitions xmlns:dmn="http://www.omg.org/spec/DMN/20180521/MODEL/" xmlns="https://kie.apache.org/dmn/_E1F2A3B4-C5D6-7E8F-9A0B-1C2D3E4F5A6B" xmlns:feel="http://www.omg.org/spec/DMN/20180521/FEEL/" xmlns:kie="http://www.drools.org/kie/dmn/1.2" xmlns:dmndi="http://www.omg.org/spec/DMN/20180521/DMNDI/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:BDT="https://kie.apache.org/dmn/_1B91A885-130A-4E0B-A762-E12AA6DD5C79" id="_F2A3B4C5-D6E7-8F9A-0B1C-2D3E4F5A6B7C" name="AbleAccountExclusion" typeLanguage="http://www.omg.org/spec/DMN/20180521/FEEL/" namespace="https://kie.apache.org/dmn/_E1F2A3B4-C5D6-7E8F-9A0B-1C2D3E4F5A6B">
  <dmn:extensionElements/>
  <dmn:import id="_A3B4C5D6-E7F8-9A0B-1C2D-3E4F5A6B7C8D" name="BDT" namespace="https://kie.apache.org/dmn/_1B91A885-130A-4E0B-A762-E12AA6DD5C79" locationURI="../../BDT.dmn" importType="http://www.omg.org/spec/DMN/20180521/MODEL/"/>

  <!-- Define tParameters for this check -->
  <dmn:itemDefinition id="_able_tParameters" name="tParameters" isCollection="false">
    <dmn:itemComponent id="_able_tParameters_resources" name="resources" isCollection="false">
      <dmn:typeRef>BDT.tResourceList</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>

  <!-- Input: situation (standard check pattern) -->
  <dmn:inputData id="_able_situation_input" name="situation">
    <dmn:extensionElements/>
    <dmn:variable id="_able_situation_var" name="situation" typeRef="BDT.tSituation"/>
  </dmn:inputData>

  <!-- Input: parameters with resources list -->
  <dmn:inputData id="_able_parameters_input" name="parameters">
    <dmn:extensionElements/>
    <dmn:variable id="_able_parameters_var" name="parameters" typeRef="tParameters"/>
  </dmn:inputData>

  <!-- Decision: extract resources from parameters -->
  <dmn:decision id="_able_resources_decision" name="resources">
    <dmn:extensionElements/>
    <dmn:variable id="_able_resources_var" name="resources" typeRef="BDT.tResourceList"/>
    <dmn:informationRequirement id="_able_resources_req1">
      <dmn:requiredInput href="#_able_situation_input"/>
    </dmn:informationRequirement>
    <dmn:informationRequirement id="_able_resources_req2">
      <dmn:requiredInput href="#_able_parameters_input"/>
    </dmn:informationRequirement>
    <dmn:literalExpression id="_able_resources_expr">
      <dmn:text>if parameters.resources != null then parameters.resources else []</dmn:text>
    </dmn:literalExpression>
  </dmn:decision>

  <dmn:decision id="_B4C5D6E7-F8A9-0B1C-2D3E-4F5A6B7C8D9E" name="ableAccountsTotal">
    <dmn:extensionElements/>
    <dmn:variable id="_C5D6E7F8-A9B0-1C2D-3E4F-5A6B7C8D9E0F" name="ableAccountsTotal" typeRef="number"/>
    <dmn:informationRequirement id="_D6E7F8A9-B0C1-2D3E-4F5A-6B7C8D9E0F1A">
      <dmn:requiredDecision href="#_able_resources_decision"/>
    </dmn:informationRequirement>
    <dmn:literalExpression id="_F8A9B0C1-D2E3-4F5A-6B7C-8D9E0F1A2B3C">
      <dmn:text>if resources = null then 0 else sum(for r in resources return if r.type = "able_account" then r.value else 0)</dmn:text>
    </dmn:literalExpression>
  </dmn:decision>

  <dmn:decision id="_A9B0C1D2-E3F4-5A6B-7C8D-9E0F1A2B3C4D" name="excludedAmount">
    <dmn:extensionElements/>
    <dmn:variable id="_B0C1D2E3-F4A5-6B7C-8D9E-0F1A2B3C4D5E" name="excludedAmount" typeRef="number"/>
    <dmn:informationRequirement id="_C1D2E3F4-A5B6-7C8D-9E0F-1A2B3C4D5E6F">
      <dmn:requiredDecision href="#_B4C5D6E7-F8A9-0B1C-2D3E-4F5A6B7C8D9E"/>
    </dmn:informationRequirement>
    <dmn:literalExpression id="_D2E3F4A5-B6C7-8D9E-0F1A-2B3C4D5E6F7A">
      <dmn:text>if ableAccountsTotal &gt; 100000 then 100000 else ableAccountsTotal</dmn:text>
    </dmn:literalExpression>
  </dmn:decision>

  <dmn:decision id="_able_checkResult_decision" name="checkResult">
    <dmn:description>Returns true if any ABLE account qualifies for exclusion</dmn:description>
    <dmn:extensionElements/>
    <dmn:variable id="_able_checkResult_var" name="checkResult" typeRef="boolean"/>
    <dmn:informationRequirement id="_able_checkResult_req">
      <dmn:requiredDecision href="#_A9B0C1D2-E3F4-5A6B-7C8D-9E0F1A2B3C4D"/>
    </dmn:informationRequirement>
    <dmn:literalExpression id="_able_checkResult_expr">
      <dmn:text>excludedAmount > 0</dmn:text>
    </dmn:literalExpression>
  </dmn:decision>

  <dmn:decisionService id="_F4A5B6C7-D8E9-0F1A-2B3C-4D5E6F7A8B9C" name="AbleAccountExclusionService">
    <dmn:extensionElements/>
    <dmn:variable id="_A5B6C7D8-E9F0-1A2B-3C4D-5E6F7A8B9C0D" name="AbleAccountExclusionService" typeRef="BDT.tCheckResponse"/>
    <dmn:outputDecision href="#_able_checkResult_decision"/>
    <dmn:encapsulatedDecision href="#_A9B0C1D2-E3F4-5A6B-7C8D-9E0F1A2B3C4D"/>
    <dmn:encapsulatedDecision href="#_B4C5D6E7-F8A9-0B1C-2D3E-4F5A6B7C8D9E"/>
    <dmn:encapsulatedDecision href="#_able_resources_decision"/>
    <dmn:inputData href="#_able_situation_input"/>
    <dmn:inputData href="#_able_parameters_input"/>
  </dmn:decisionService>

  <dmn:textAnnotation id="_B6C7D8E9-F0A1-2B3C-4D5E-6F7A8B9C0D1E" textFormat="text/plain">
    <dmn:text>SSI ABLE Account Exclusion (POMS SI 01130.740)
ABLE accounts excluded up to $100,000</dmn:text>
  </dmn:textAnnotation>

  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="_C7D8E9F0-A1B2-3C4D-5E6F-7A8B9C0D1E2F" name="DRG">
      <di:extension>
        <kie:ComponentsWidthsExtension>
          <kie:ComponentWidths dmnElementRef="_F8A9B0C1-D2E3-4F5A-6B7C-8D9E0F1A2B3C">
            <kie:width>800</kie:width>
          </kie:ComponentWidths>
          <kie:ComponentWidths dmnElementRef="_D2E3F4A5-B6C7-8D9E-0F1A-2B3C4D5E6F7A">
            <kie:width>800</kie:width>
          </kie:ComponentWidths>
        </kie:ComponentsWidthsExtension>
      </di:extension>
      <dmndi:DMNShape id="dmnshape-drg-_able_situation_input" dmnElementRef="_able_situation_input" isCollapsed="false">
        <dmndi:DMNStyle>
          <dmndi:FillColor red="255" green="255" blue="255"/>
          <dmndi:StrokeColor red="0" green="0" blue="0"/>
          <dmndi:FontColor red="0" green="0" blue="0"/>
        </dmndi:DMNStyle>
        <dc:Bounds x="150" y="400" width="100" height="50"/>
        <dmndi:DMNLabel/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="dmnshape-drg-_able_parameters_input" dmnElementRef="_able_parameters_input" isCollapsed="false">
        <dmndi:DMNStyle>
          <dmndi:FillColor red="255" green="255" blue="255"/>
          <dmndi:StrokeColor red="0" green="0" blue="0"/>
          <dmndi:FontColor red="0" green="0" blue="0"/>
        </dmndi:DMNStyle>
        <dc:Bounds x="350" y="400" width="100" height="50"/>
        <dmndi:DMNLabel/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="dmnshape-drg-_B4C5D6E7-F8A9-0B1C-2D3E-4F5A6B7C8D9E" dmnElementRef="_B4C5D6E7-F8A9-0B1C-2D3E-4F5A6B7C8D9E" isCollapsed="false">
        <dmndi:DMNStyle>
          <dmndi:FillColor red="255" green="255" blue="255"/>
          <dmndi:StrokeColor red="0" green="0" blue="0"/>
          <dmndi:FontColor red="0" green="0" blue="0"/>
        </dmndi:DMNStyle>
        <dc:Bounds x="250" y="230" width="100" height="50"/>
        <dmndi:DMNLabel/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="dmnshape-drg-_A9B0C1D2-E3F4-5A6B-7C8D-9E0F1A2B3C4D" dmnElementRef="_A9B0C1D2-E3F4-5A6B-7C8D-9E0F1A2B3C4D" isCollapsed="false">
        <dmndi:DMNStyle>
          <dmndi:FillColor red="255" green="255" blue="255"/>
          <dmndi:StrokeColor red="0" green="0" blue="0"/>
          <dmndi:FontColor red="0" green="0" blue="0"/>
        </dmndi:DMNStyle>
        <dc:Bounds x="250" y="150" width="100" height="50"/>
        <dmndi:DMNLabel/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="dmnshape-drg-_F4A5B6C7-D8E9-0F1A-2B3C-4D5E6F7A8B9C" dmnElementRef="_F4A5B6C7-D8E9-0F1A-2B3C-4D5E6F7A8B9C" isCollapsed="false">
        <dmndi:DMNStyle>
          <dmndi:FillColor red="255" green="255" blue="255"/>
          <dmndi:StrokeColor red="0" green="0" blue="0"/>
          <dmndi:FontColor red="0" green="0" blue="0"/>
        </dmndi:DMNStyle>
        <dc:Bounds x="200" y="80" width="200" height="60"/>
        <dmndi:DMNLabel/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="dmnshape-drg-_B6C7D8E9-F0A1-2B3C-4D5E-6F7A8B9C0D1E" dmnElementRef="_B6C7D8E9-F0A1-2B3C-4D5E-6F7A8B9C0D1E" isCollapsed="false">
        <dmndi:DMNStyle fontSize="14">
          <dmndi:FillColor red="255" green="255" blue="255"/>
          <dmndi:StrokeColor red="0" green="0" blue="0"/>
          <dmndi:FontColor red="0" green="0" blue="0"/>
        </dmndi:DMNStyle>
        <dc:Bounds x="450" y="150" width="300" height="80"/>
        <dmndi:DMNLabel/>
      </dmndi:DMNShape>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</dmn:definitions>
